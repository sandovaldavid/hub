{
  "name": "linktree",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "NODE_VARIANT": "24-trixie",
      "BUN_VERSION": "1.3.14",
      "PLAYWRIGHT_VERSION": "1.61.0"
    },
    "cacheFrom": [
      "ghcr.io/sandovaldavid/linktree-devcontainer:main",
      "ghcr.io/sandovaldavid/linktree-devcontainer:develop"
    ]
  },
  "runArgs": [
    "--security-opt",
    "label=disable"
  ],
  "mounts": [
    "source=devcontainer-${localWorkspaceFolderBasename}-zsh-history,target=/commandhistory,type=volume"
  ],
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false,
      "username": "node"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[astro]": {
          "editor.defaultFormatter": "astro-build.astro-vscode"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n",
        "remote.restoreForwardedPorts": true
      },
      "extensions": [
        "astro-build.astro-vscode",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "containerEnv": {
    "DEVCONTAINER": "true",
    "ZSH_HISTORY_FILE": "/commandhistory/.zsh_history",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    "PLAYWRIGHT_HTML_HOST": "0.0.0.0",
    "PLAYWRIGHT_HTML_PORT": "9323"
  },
  "forwardPorts": [
    4321,
    9323
  ],
  "portsAttributes": {
    "4321": {
      "label": "Astro development server",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": true
    },
    "9323": {
      "label": "Playwright HTML report",
      "protocol": "http",
      "onAutoForward": "openBrowserOnce",
      "requireLocalPort": true
    }
  },
  "init": true,
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "bash .devcontainer/scripts/post-start.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "shutdownAction": "stopContainer"
}
