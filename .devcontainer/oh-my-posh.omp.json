{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"version": 4,
	"final_space": true,
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"type": "session",
					"style": "plain",
					"foreground": "#89B4FA",
					"template": "{{ .UserName }}@{{ .HostName }} "
				},
				{
					"type": "path",
					"style": "plain",
					"foreground": "#A6E3A1",
					"options": {
						"style": "folder"
					},
					"template": "{{ .Path }} "
				},
				{
					"type": "git",
					"style": "plain",
					"foreground": "#F9E2AF",
					"options": {
						"fetch_status": true
					},
					"template": "[{{ .HEAD }}{{ if .Working.Changed }}*{{ end }}] "
				}
			]
		},
		{
			"type": "prompt",
			"newline": true,
			"segments": [
				{
					"type": "text",
					"style": "plain",
					"foreground": "#CDD6F4",
					"template": "$ "
				}
			]
		}
	]
}
