{
	"name": "hub-sandovaldavid",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "astro dev --host 0.0.0.0",
		"prebuild": "node scripts/check-architecture.mjs",
		"build": "astro build",
		"preview": "astro preview --host 0.0.0.0",
		"preview:test": "astro preview --host 0.0.0.0 --port 4322",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --write src/entities/featured-project/ui/FeaturedProjectCard.astro tests/e2e/desktop-layout.spec.ts tests/e2e/home.spec.ts tests/e2e/visual-regressions.spec.ts && git diff -- src/entities/featured-project/ui/FeaturedProjectCard.astro tests/e2e/desktop-layout.spec.ts tests/e2e/home.spec.ts tests/e2e/visual-regressions.spec.ts && false",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check:architecture": "node scripts/check-architecture.mjs",
		"check:links": "node scripts/check-links.mjs",
		"audit:deps": "bun audit",
		"rulesets:plan": "node scripts/manage-rulesets.mjs plan",
		"rulesets:stage": "node scripts/manage-rulesets.mjs stage",
		"rulesets:apply": "node scripts/manage-rulesets.mjs apply",
		"rulesets:verify": "node scripts/manage-rulesets.mjs verify",
		"test:unit": "bun test tests/unit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:show-report": "playwright show-report --host 0.0.0.0 --port 9323",
		"test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
		"test:lighthouse:mobile": "node scripts/run-lighthouse.mjs mobile",
		"test:lighthouse:desktop": "node scripts/run-lighthouse.mjs desktop",
		"test:lighthouse": "bun run test:lighthouse:mobile && bun run test:lighthouse:desktop",
		"validate:quality": "bun x astro check && bun run check:architecture && bun run format:check && bun run lint && bun run check:links && bun run test:unit && bun run build",
		"validate:local": "bun scripts/run-local-validation.mjs",
		"validate:local:inside": "bun run validate:quality && CI=1 bun run test:e2e && bun run test:lighthouse",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"astro": "7.2.9",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.61.0",
		"chrome-launcher": "^1.2.1",
		"eslint": "^10.9.0",
		"eslint-plugin-astro": "^3.1.0",
		"husky": "^9.1.7",
		"lighthouse": "13.4.1",
		"picomatch": "2.3.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"overrides": {
		"@astrojs/language-server": "2.16.14",
		"brace-expansion": "5.0.9",
		"fast-uri": "3.1.6",
		"ip-address": "10.5.0",
		"js-yaml": "4.3.1",
		"mdast-util-to-hast": "13.2.1",
		"nanoid": "3.3.18",
		"sharp": "0.35.4",
		"svgo": "4.0.2"
	}
}
