---
/**
 * ProfileAvatar Component - FSD Layer: entities/profile
 * Displays user profile avatar with customizable size
 */

import { Avatar } from '@shared/ui';

export interface Props {
	src: string;
	alt: string;
	size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl';
	ring?: boolean;
	class?: string;
}

const { src, alt, size = 'lg', ring = true, class: className } = Astro.props;
---

<Avatar
	{src}
	{alt}
	{size}
	{ring}
	ringColor="ring-primary-500"
	class={className}
/>
