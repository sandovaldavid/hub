---
/**
 * ProfileAvatar Component - FSD Layer: entities/profile
 * Displays user profile avatar with an optional brand logo badge
 */

import Avatar from '@shared/ui/Avatar.astro';

export interface Props {
	src: string;
	alt: string;
	size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl';
	ring?: boolean;
	showBrandLogo?: boolean;
	brandLogoLightSrc?: string;
	brandLogoDarkSrc?: string;
	class?: string;
}

const {
	src,
	alt,
	size = 'lg',
	ring = true,
	showBrandLogo = true,
	brandLogoLightSrc,
	brandLogoDarkSrc,
	class: className,
} = Astro.props;

const brandLogoSources =
	brandLogoLightSrc && brandLogoDarkSrc
		? { light: brandLogoLightSrc, dark: brandLogoDarkSrc }
		: null;
---

<div class="relative inline-block w-fit">
	<Avatar
		{src}
		{alt}
		{size}
		{ring}
		loading="eager"
		fetchpriority="high"
		ringColor="ring-channel-accent-primary"
		class={className}
	/>

	{
		showBrandLogo && brandLogoSources && ['3xl', '4xl'].includes(size) && (
			<span
				data-profile-brand-logo
				class="absolute right-0 bottom-0 flex size-12 items-center justify-center rounded-full border border-channel-edge-default bg-channel-surface-default shadow-xs"
				aria-hidden="true">
				<img
					src={brandLogoSources.light}
					data-logo-mode="light"
					alt=""
					role="presentation"
					width="32"
					height="32"
					loading="eager"
					fetchpriority="low"
					decoding="async"
					class="size-8 shrink-0 dark:hidden"
				/>
				<img
					src={brandLogoSources.dark}
					data-logo-mode="dark"
					alt=""
					role="presentation"
					width="32"
					height="32"
					loading="eager"
					fetchpriority="low"
					decoding="async"
					class="hidden size-8 shrink-0 dark:block"
				/>
			</span>
		)
	}
</div>
