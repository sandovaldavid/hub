---
/**
 * ProfileAvatar Component - FSD Layer: entities/profile
 * Displays user profile avatar with an optional brand logo badge
 */

import { Avatar } from '@shared/ui';

export interface Props {
	src: string;
	alt: string;
	size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl';
	ring?: boolean;
	showBrandLogo?: boolean;
	brandLogoSrc?: string;
	class?: string;
}

const {
	src,
	alt,
	size = 'lg',
	ring = true,
	showBrandLogo = true,
	brandLogoSrc,
	class: className,
} = Astro.props;

const logoSizeMap = {
	xs: { className: 'h-4 w-4', dimension: 16 },
	sm: { className: 'h-5 w-5', dimension: 20 },
	md: { className: 'h-6 w-6', dimension: 24 },
	lg: { className: 'h-8 w-8', dimension: 32 },
	xl: { className: 'h-10 w-10', dimension: 40 },
	'2xl': { className: 'h-12 w-12', dimension: 48 },
	'3xl': { className: 'h-16 w-16', dimension: 64 },
	'4xl': { className: 'h-20 w-20', dimension: 80 },
} as const;

const logoSize = logoSizeMap[size];
---

<div class="relative inline-block w-fit" role="img" aria-label={alt}>
	<Avatar
		{src}
		{alt}
		{size}
		{ring}
		loading="eager"
		fetchpriority="high"
		ringColor="ring-channel-accent-primary"
		class={className}
	/>

	{
		showBrandLogo && brandLogoSrc && (
			<img
				src={brandLogoSrc}
				alt=""
				role="presentation"
				aria-hidden="true"
				width={logoSize.dimension}
				height={logoSize.dimension}
				loading="eager"
				fetchpriority="low"
				decoding="async"
				class={`absolute right-0 bottom-0 ${logoSize.className} rounded-full border border-card-edge bg-channel-surface-default shadow-xs transition-transform duration-200 hover:scale-105`}
			/>
		)
	}
</div>
