---
/**
 * ProfileAvatar Component - FSD Layer: entities/profile
 * Displays user profile avatar with an optional brand logo badge
 */

import Avatar from '@shared/ui/Avatar.astro';

export interface Props {
	src: string;
	alt: string;
	size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl';
	ring?: boolean;
	showBrandLogo?: boolean;
	brandLogoSrc?: string;
	class?: string;
}

const {
	src,
	alt,
	size = 'lg',
	ring = true,
	showBrandLogo = true,
	brandLogoSrc,
	class: className,
} = Astro.props;
---

<div class="relative inline-block w-fit">
	<Avatar
		{src}
		{alt}
		{size}
		{ring}
		loading="eager"
		fetchpriority="high"
		ringColor="ring-channel-accent-primary"
		class={className}
	/>

	{
		showBrandLogo && brandLogoSrc && ['3xl', '4xl'].includes(size) && (
			<span
				data-theme="dark"
				class="absolute right-0 bottom-0 flex size-[38px] items-center justify-center rounded-full border border-channel-edge-default bg-channel-surface-default shadow-xs"
				aria-hidden="true">
				<img
					src={brandLogoSrc}
					alt=""
					role="presentation"
					width="24"
					height="24"
					loading="eager"
					fetchpriority="low"
					decoding="async"
					class="size-6 shrink-0"
				/>
			</span>
		)
	}
</div>
