---
/**
 * ProfileName Component - FSD Layer: entities/profile
 * Displays profile name with optional tagline
 */

import { cn } from '@shared/lib';
import './ProfileName.css';
import CheckIcon from '@shared/assets/check.svg';

export interface Props {
	name: string;
	displayName?: string;
	tagline?: string;
	variant?: 'hero' | 'compact';
	class?: string;
}

const {
	name,
	displayName,
	tagline,
	variant = 'hero',
	class: className,
} = Astro.props;

const isHero = variant === 'hero';
---

<div class={cn('profile-name', className)}>
	<section class="flex flex-col justify-center items-center z-10 gap-1">
		<span
			class={cn(
				'text-primary-600 text-xl font-google font-semibold weight italic px-3 py-1',
				'bg-gray-500/20 flex items-center gap-2',
				'border border-primary-500/60 rounded-full shadow-md cursor-pointer',
				'animate-delay-200 animate-fade-in transition-colors duration-200 hover:bg-gray-500/50 hover:dark:bg-gray-500/30',
			)}>
			@{displayName}
			<CheckIcon
				class="size-6 text-sky-500 inline-block animate-rubber-band animate-delay-300"
			/>
		</span>
		<h1
			class={cn(
				'font-display text-2xl font-extrabold leading-tight text-center',
				'text-gray-900 dark:text-gray-50'
			)}>
			{name}
		</h1>
	</section>

	{tagline && <p class={cn('profile-name__tagline')}>{tagline}</p>}
</div>
