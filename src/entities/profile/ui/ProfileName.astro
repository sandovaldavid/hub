---
/**
 * ProfileName Component - FSD Layer: entities/profile
 * Displays profile name with optional tagline
 */

import { cn } from '@shared/lib';
import './ProfileName.css';
import CheckIcon from '@shared/assets/check.svg';

export interface Props {
	id?: string;
	name: string;
	displayName?: string;
	tagline?: string;
	variant?: 'hero' | 'compact';
	class?: string;
}

const { id, name, displayName, tagline, class: className } = Astro.props;
---

<div class={cn('profile-name', className)}>
	<section class="z-10 flex flex-col items-center justify-center gap-1">
		<span
			class={cn(
				'flex cursor-pointer items-center gap-2 rounded-full border px-3 py-1',
				'font-technical text-xl font-semibold italic text-channel-accent-primary',
				'bg-card-background-muted border-card-edge-accent shadow-xs',
				'animate-delay-200 animate-fade-in transition-colors duration-200 hover:bg-control-background-hover'
			)}>
			@{displayName}
			<CheckIcon
				class="animate-rubber-band animate-delay-300 inline-block size-6 text-channel-accent-secondary"
				aria-hidden="true"
			/>
		</span>
		<h2
			{...id && { id }}
			class={cn(
				'font-display text-center text-2xl font-extrabold leading-tight',
				'text-channel-content-strong'
			)}>
			{name}
		</h2>
	</section>

	{tagline && <p class={cn('profile-name__tagline')}>{tagline}</p>}
</div>
