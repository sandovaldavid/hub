---
/**
 * BrandLogo Component - FSD Layer: entities/profile
 * Displays brand logo with configurable size
 */

import { cn } from '@shared/lib';

export interface Props {
	src: string;
	alt: string;
	size?: 'sm' | 'md' | 'lg' | 'xl';
	class?: string;
}

const { src, alt, size = 'md', class: className } = Astro.props;

const sizeConfig = {
	sm: { className: 'h-8 w-auto', dimension: 32 },
	md: { className: 'h-12 w-auto', dimension: 48 },
	lg: { className: 'h-16 w-auto', dimension: 64 },
	xl: { className: 'h-24 w-auto', dimension: 96 },
} as const;

const logo = sizeConfig[size];
---

<img
	{src}
	{alt}
	width={logo.dimension}
	height={logo.dimension}
	loading="eager"
	decoding="async"
	class={cn('brand-logo', logo.className, className)}
/>
