---
import { cn } from '@shared/lib';
import './SocialButton.css';
import type { ConversionEvent } from '@shared/analytics/conversion';

export interface Props {
	url: string;
	label: string;
	username?: string;
	analyticsId: string;
	variant?: 'default' | 'compact';
	lang?: 'en' | 'es';
	class?: string;
}

const {
	url,
	label,
	username,
	analyticsId,
	variant = 'default',
	lang = 'en',
	class: className,
} = Astro.props;

const normalizedId = analyticsId.toLowerCase();
const ariaLabel = lang === 'es' ? `Visita el perfil de ${label}` : `Visit ${label} profile`;
const conversionEvent: ConversionEvent | undefined = normalizedId.includes('linkedin')
	? 'linkedin_opened'
	: normalizedId.includes('github')
		? 'github_opened'
		: undefined;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class={cn('social-button group', variant === 'compact' && 'social-button--compact', className)}
	data-analytics-id={analyticsId}
	data-conversion-event={conversionEvent}
	data-conversion-position="social"
	data-conversion-item={normalizedId}
	aria-label={ariaLabel}>
	<span class="social-button__icon" aria-hidden="true">
		<slot name="icon" />
	</span>

	<div class="social-button__content">
		<span class="social-button__label">{label}</span>
		{username && <span class="social-button__username">{username}</span>}
	</div>
</a>
