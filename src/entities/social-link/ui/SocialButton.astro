---
import { cn } from '@shared/lib/utils';
import './SocialButton.css';
import type { ConversionEvent } from '@shared/analytics/conversion';
import { useTranslations, type Lang } from '@shared/i18n';

export interface Props {
	url: string;
	label: string;
	username?: string;
	analyticsId: string;
	conversionEvent?: ConversionEvent;
	variant?: 'default' | 'compact';
	lang?: Lang;
	class?: string;
}

const {
	url,
	label,
	username,
	analyticsId,
	conversionEvent,
	variant = 'default',
	lang = 'en',
	class: className,
} = Astro.props;

const t = useTranslations(lang);
const ariaLabel = t('social.profileLinkAria', { platform: label });
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class={cn('social-button group', variant === 'compact' && 'social-button--compact', className)}
	data-analytics-id={analyticsId}
	data-conversion-event={conversionEvent}
	data-conversion-position={conversionEvent ? 'social' : undefined}
	data-conversion-item={conversionEvent ? analyticsId.toLowerCase() : undefined}
	aria-label={ariaLabel}>
	<span class="social-button__icon" aria-hidden="true">
		<slot name="icon" />
	</span>

	<div class="social-button__content">
		<span class="social-button__label">{label}</span>
		{username && <span class="social-button__username">{username}</span>}
	</div>
</a>
