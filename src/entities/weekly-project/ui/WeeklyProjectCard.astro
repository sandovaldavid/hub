---
import type { WeeklyProject } from '../model/types';
import LinkIcon from '@shared/assets/link.svg';
import GitHubIcon from '@shared/assets/social-platform/github.svg';
import './WeeklyProjectCard.css';

interface Props {
	project: WeeklyProject;
	lang: 'en' | 'es';
	position: number;
}

const { project, lang, position } = Astro.props;
const labels =
	lang === 'es'
		? {
				caseStudy: 'Caso destacado',
				problem: 'Problema',
				contribution: 'Mi contribución',
				outcome: 'Resultado',
				repository: 'Repositorio',
				demo: 'Demo',
				private: 'Repo privado',
				demoUnavailable: 'Sin demo público',
				technologyStack: 'Tecnologías utilizadas',
			}
		: {
				caseStudy: 'Selected case',
				problem: 'Problem',
				contribution: 'My contribution',
				outcome: 'Outcome',
				repository: 'Repository',
				demo: 'Live demo',
				private: 'Private repo',
				demoUnavailable: 'No public demo',
				technologyStack: 'Technology stack',
			};

const evidence = [
	{ label: labels.problem, value: project.problem, kind: 'problem', marker: '01' },
	{
		label: labels.contribution,
		value: project.contribution,
		kind: 'contribution',
		marker: '02',
	},
	{ label: labels.outcome, value: project.outcome, kind: 'outcome', marker: '03' },
] as const;

const statusTone =
	project.demoAvailability === 'public'
		? 'live'
		: project.repositoryAvailability === 'public'
			? 'active'
			: 'private';

const caseNumber = String(position).padStart(2, '0');
---

<article
	class="weekly-project-card"
	data-project-card
	data-project-id={project.id}
	data-project-position={position}>
	<div class="weekly-project-card__content">
		<header class="weekly-project-card__heading">
			<div class="weekly-project-card__meta">
				<span class="weekly-project-card__index">{labels.caseStudy} {caseNumber}</span>
				<span class="weekly-project-card__status" data-status-tone={statusTone}>
					{project.status}
				</span>
			</div>
			<h3 class="weekly-project-card__title">{project.title}</h3>
		</header>

		<dl class="weekly-project-card__evidence">
			{
				evidence.map(item => (
					<div
						class={`weekly-project-card__evidence-item weekly-project-card__evidence-item--${item.kind}`}
						data-project-evidence={item.kind}>
						<dt>
							<span class="weekly-project-card__evidence-marker" aria-hidden="true">
								{item.marker}
							</span>
							<span>{item.label}</span>
						</dt>
						<dd>{item.value}</dd>
					</div>
				))
			}
		</dl>

		<div class="weekly-project-card__technologies" aria-label={labels.technologyStack}>
			{
				project.technologies.map(tech => (
					<span class="weekly-project-card__tech-badge">{tech}</span>
				))
			}
		</div>

		<div class="weekly-project-card__actions">
			{
				project.demoAvailability === 'public' && project.demoUrl ? (
					<a
						href={project.demoUrl}
						class="weekly-project-card__button weekly-project-card__button--primary"
						target="_blank"
						rel="noopener noreferrer"
						data-conversion-event="project_opened"
						data-conversion-position="project"
						data-conversion-item={project.id}>
						<span>{labels.demo}</span>
						<LinkIcon class="weekly-project-card__button-icon" />
					</a>
				) : (
					<span class="weekly-project-card__availability">{labels.demoUnavailable}</span>
				)
			}
			{
				project.repositoryAvailability === 'public' && project.githubUrl ? (
					<a
						href={project.githubUrl}
						class="weekly-project-card__button weekly-project-card__button--secondary"
						target="_blank"
						rel="noopener noreferrer"
						data-conversion-event="project_opened"
						data-conversion-position="project"
						data-conversion-item={project.id}>
						<GitHubIcon class="weekly-project-card__button-icon" />
						<span>{labels.repository}</span>
					</a>
				) : (
					<span class="weekly-project-card__availability">{labels.private}</span>
				)
			}
		</div>
	</div>
</article>
