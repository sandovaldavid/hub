---
import type { WeeklyProject } from '../model/types';
import LinkIcon from '@shared/assets/link.svg';
import GitHubIcon from '@shared/assets/social-platform/github.svg';
import './WeeklyProjectCard.css';

interface Props {
	project: WeeklyProject;
	lang: 'en' | 'es';
}

const { project, lang } = Astro.props;
const labels =
	lang === 'es'
		? {
				problem: 'Problema',
				contribution: 'Mi contribución',
				outcome: 'Resultado',
				repository: 'Repositorio',
				demo: 'Demo',
				private: 'Repositorio privado',
				unavailable: 'No disponible',
			}
		: {
				problem: 'Problem',
				contribution: 'My contribution',
				outcome: 'Outcome',
				repository: 'Repository',
				demo: 'Live demo',
				private: 'Private repository',
				unavailable: 'Not available',
			};
---

<article class="weekly-project-card">
	<div class="weekly-project-card__content">
		<div class="weekly-project-card__heading">
			<h3 class="weekly-project-card__title">{project.title}</h3>
			<span class="weekly-project-card__status">{project.status}</span>
		</div>

		<dl class="weekly-project-card__evidence">
			<div><dt>{labels.problem}</dt><dd>{project.problem}</dd></div>
			<div><dt>{labels.contribution}</dt><dd>{project.contribution}</dd></div>
			<div><dt>{labels.outcome}</dt><dd>{project.outcome}</dd></div>
		</dl>

		<div class="weekly-project-card__technologies" aria-label="Technology stack">
			{
				project.technologies.map(tech => (
					<span class="weekly-project-card__tech-badge">{tech}</span>
				))
			}
		</div>

		<div class="weekly-project-card__actions">
			{
				project.demoAvailability === 'public' && project.demoUrl ? (
					<a
						href={project.demoUrl}
						class="weekly-project-card__button weekly-project-card__button--primary"
						target="_blank"
						rel="noopener noreferrer">
						<>
							<span>{labels.demo}</span>
							<LinkIcon class="weekly-project-card__button-icon" />
						</>
					</a>
				) : (
					<span class="weekly-project-card__availability">
						{labels.demo}: {labels.unavailable}
					</span>
				)
			}
			{
				project.repositoryAvailability === 'public' && project.githubUrl ? (
					<a
						href={project.githubUrl}
						class="weekly-project-card__button weekly-project-card__button--secondary"
						target="_blank"
						rel="noopener noreferrer">
						<>
							<GitHubIcon class="weekly-project-card__button-icon" />
							<span>{labels.repository}</span>
						</>
					</a>
				) : (
					<span class="weekly-project-card__availability">{labels.private}</span>
				)
			}
		</div>
	</div>
</article>
