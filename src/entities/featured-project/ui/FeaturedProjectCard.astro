---
import type { FeaturedProject } from '../model/types';
import LinkIcon from '@shared/assets/link.svg';
import GitHubIcon from '@shared/assets/social-platform/github.svg';
import { useTranslations, type Lang } from '@shared/i18n';
import './FeaturedProjectCard.css';

interface Props {
	project: FeaturedProject;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const hasPublicProject = project.projectAvailability === 'public' && Boolean(project.projectUrl);
const hasPublicRepository =
	project.repositoryAvailability === 'public' && Boolean(project.githubUrl);
const hasPublicCaseStudy = Boolean(project.caseStudyUrl);
const isPrivateProject = !hasPublicProject && !hasPublicRepository;
const actionCount = [hasPublicProject, hasPublicCaseStudy, hasPublicRepository].filter(Boolean).length;
---

<article class="featured-project-card" data-project-card data-project-id={project.id}>
	<div class="featured-project-card__content">
		<header class="featured-project-card__heading">
			<div class="featured-project-card__title-row">
				<h3 class="featured-project-card__title">{project.title}</h3>
				{
					isPrivateProject && (
						<span class="featured-project-card__privacy-badge">{t('projects.private')}</span>
					)
				}
			</div>
			<p class="featured-project-card__summary">{project.summary}</p>
		</header>

		<div class="featured-project-card__actions" data-action-count={actionCount}>
			{
				hasPublicProject && project.projectUrl && (
					<a
						href={project.projectUrl}
						class="featured-project-card__button featured-project-card__button--primary"
						target="_blank"
						rel="noopener noreferrer"
						data-conversion-event="project_opened"
						data-conversion-position="project"
						data-conversion-item={project.id}>
						<span>{t('projects.projectSite')}</span>
						<LinkIcon class="featured-project-card__button-icon" />
					</a>
				)
			}
			{
				hasPublicCaseStudy && project.caseStudyUrl && (
					<a
						href={project.caseStudyUrl}
						class={`featured-project-card__button ${hasPublicProject ? 'featured-project-card__button--secondary' : 'featured-project-card__button--primary'}`}
						target="_blank"
						rel="noopener noreferrer"
						data-conversion-event="project_opened"
						data-conversion-position="project"
						data-conversion-item={project.id}>
						<span>{t('projects.viewCaseStudy')}</span>
						<LinkIcon class="featured-project-card__button-icon" />
					</a>
				)
			}
			{
				hasPublicRepository && project.githubUrl && (
					<a
						href={project.githubUrl}
						class="featured-project-card__button featured-project-card__button--secondary"
						target="_blank"
						rel="noopener noreferrer"
						data-conversion-event="project_opened"
						data-conversion-position="project"
						data-conversion-item={project.id}>
						<GitHubIcon class="featured-project-card__button-icon" />
						<span>{t('projects.repository')}</span>
					</a>
				)
			}
		</div>
	</div>
</article>
