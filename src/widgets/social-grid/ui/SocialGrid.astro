---
import SocialButton from '@entities/social-link/ui/SocialButton.astro';
import type {
	SocialLink,
	SocialLinkPriority,
	SocialPlatform,
} from '@entities/social-link/model/types';
import { cn } from '@shared/lib/utils';
import './SocialGrid.css';

import LinkedInIcon from '@shared/assets/social-platform/linkedin.svg';
import GitHubIcon from '@shared/assets/social-platform/github.svg';
import InstagramIcon from '@shared/assets/social-platform/instagram.svg';
import XIcon from '@shared/assets/social-platform/x.svg';
import WebSiteIcon from '@shared/assets/social-platform/website.svg';

interface Props {
	links: SocialLink[];
	priorities?: SocialLinkPriority[];
	variant?: 'default' | 'compact';
	lang?: 'en' | 'es';
}

const { links, priorities = ['primary'], variant = 'default', lang = 'en' } = Astro.props as Props;
const displayLinks = links.filter(link => priorities.includes(link.priority));
const hasOddLinkCount = displayLinks.length % 2 === 1;

const platformClasses: Partial<Record<SocialPlatform, { brand?: string; icon?: string }>> = {
	website: { brand: 'social-button--website', icon: 'social-button__icon--website' },
	linkedin: { brand: 'social-button--linkedin', icon: 'social-button__icon--linkedin' },
	github: { brand: 'social-button--github', icon: 'social-button__icon--github' },
	twitter: { brand: 'social-button--x', icon: 'social-button__icon--x' },
	instagram: { brand: 'social-button--instagram', icon: 'social-button__icon--instagram' },
};
---

<div class="social-grid" data-social-count={displayLinks.length}>
	{
		displayLinks.map((link, index) => {
			const isWideItem = hasOddLinkCount && index === displayLinks.length - 1;
			const classes = platformClasses[link.platform];

			return (
				<div
					class={cn('social-grid__item', isWideItem && 'social-grid__item--wide')}
					data-priority={link.priority}
					data-audience={link.audience.join(',')}
					data-social-index={index}
					data-social-wide={isWideItem ? 'true' : undefined}>
					<SocialButton
						class={classes?.brand}
						label={link.label}
						url={link.url}
						username={link.username}
						analyticsId={link.analyticsId}
						conversionEvent={link.conversionEvent}
						{variant}
						{lang}>
						<span slot="icon">
							{link.platform === 'linkedin' && <LinkedInIcon class={`social-button__icon ${classes?.icon ?? ''}`} />}
							{link.platform === 'github' && <GitHubIcon class={`social-button__icon ${classes?.icon ?? ''}`} />}
							{link.platform === 'instagram' && <InstagramIcon class={`social-button__icon ${classes?.icon ?? ''}`} />}
							{link.platform === 'twitter' && <XIcon class={`social-button__icon ${classes?.icon ?? ''}`} />}
							{link.platform === 'website' && <WebSiteIcon class={`social-button__icon ${classes?.icon ?? ''}`} />}
						</span>
					</SocialButton>
				</div>
			);
		})
	}
</div>
