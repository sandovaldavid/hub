---
import SocialButton from '@entities/social-link/ui/SocialButton.astro';
import type { SocialLink, SocialLinkPriority } from '@entities/social-link/model/types';
import { cn } from '@shared/lib/utils';
import './SocialGrid.css';

import LinkedInIcon from '@shared/assets/social-platform/linkedin.svg';
import GitHubIcon from '@shared/assets/social-platform/github.svg';
import InstagramIcon from '@shared/assets/social-platform/instagram.svg';
import XIcon from '@shared/assets/social-platform/x.svg';
import WebSiteIcon from '@shared/assets/social-platform/website.svg';

interface Props {
	links: SocialLink[];
	priorities?: SocialLinkPriority[];
	variant?: 'default' | 'compact';
	lang?: 'en' | 'es';
}

const { links, priorities = ['primary'], variant = 'default', lang = 'en' } = Astro.props as Props;
const displayLinks = links.filter(link => priorities.includes(link.priority));
const hasOddLinkCount = displayLinks.length % 2 === 1;
---

<div class="social-grid" data-social-count={displayLinks.length}>
	{
		displayLinks.map((link, index) => {
			const isWideItem = hasOddLinkCount && index === displayLinks.length - 1;

			return (
				<div
					class={cn('social-grid__item', isWideItem && 'social-grid__item--wide')}
					data-priority={link.priority}
					data-audience={link.audience.join(',')}
					data-social-index={index}
					data-social-wide={isWideItem ? 'true' : undefined}>
					<SocialButton
						class={link.classBrand}
						label={link.label}
						url={link.url}
						username={link.username}
						analyticsId={link.analyticsId}
						{variant}
						{lang}>
						<span slot="icon">
							{link.platform === 'linkedin' && (
								<LinkedInIcon class={`social-button__icon ${link.classIcon}`} />
							)}
							{link.platform === 'github' && (
								<GitHubIcon class={`social-button__icon ${link.classIcon}`} />
							)}
							{link.platform === 'instagram' && (
								<InstagramIcon class={`social-button__icon ${link.classIcon}`} />
							)}
							{link.platform === 'twitter' && (
								<XIcon class={`social-button__icon ${link.classIcon}`} />
							)}
							{link.platform === 'website' && (
								<WebSiteIcon class={`social-button__icon ${link.classIcon}`} />
							)}
						</span>
					</SocialButton>
				</div>
			);
		})
	}
</div>
