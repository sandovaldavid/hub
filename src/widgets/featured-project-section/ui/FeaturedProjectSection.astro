---
import FeaturedProjectCard from '@entities/featured-project/ui/FeaturedProjectCard.astro';
import type { FeaturedProject } from '@entities/featured-project/model/types';
import { useTranslations, type Lang } from '@shared/i18n';
import './FeaturedProjectSection.css';

interface Props {
	projects: FeaturedProject[];
	lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="featured-project-section" aria-labelledby="featured-projects-title">
	<div class="featured-project-section__header">
		<h2 id="featured-projects-title" class="featured-project-section__title">
			{t('projects.title')}
		</h2>
		<p class="featured-project-section__subtitle">{t('projects.description')}</p>
	</div>
	<div class="featured-project-section__content" data-project-count={projects.length}>
		{
			projects.map((project, index) => (
				<FeaturedProjectCard {project} {lang} position={index + 1} />
			))
		}
	</div>
</section>
