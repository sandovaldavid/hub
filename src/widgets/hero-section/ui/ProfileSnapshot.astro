---
import type { HeroMetadataItem } from '../model/types';
import './ProfileSnapshot.css';

interface Props {
	heading: string;
	bio: string;
	metadata: HeroMetadataItem[];
}

const { heading, bio, metadata } = Astro.props;
const localizedMetadata = metadata.map(item => ({
	...item,
	parts: item.value.split(/\s*·\s*/u),
}));
---

<section
	class="profile-snapshot"
	data-layout-panel="profile-snapshot"
	aria-labelledby="profile-snapshot-heading">
	<div class="profile-snapshot__summary">
		<h2 id="profile-snapshot-heading" class="profile-snapshot__heading">{heading}</h2>
		<p class="profile-snapshot__bio">{bio}</p>
	</div>

	<dl class="profile-snapshot__metadata">
		{
			localizedMetadata.map((item, itemIndex) => (
				<div class="profile-snapshot__metadata-item">
					<dt class="sr-only">{item.label}</dt>
					<dd>
						{item.parts.map((part, partIndex) => (
							<>
								{partIndex > 0 && (
									<span class="profile-snapshot__separator" aria-hidden="true">
										&middot;
									</span>
								)}
								<span>{part}</span>
							</>
						))}
						{itemIndex < localizedMetadata.length - 1 && (
							<span
								class="profile-snapshot__separator profile-snapshot__separator--group"
								aria-hidden="true">
								&middot;
							</span>
						)}
					</dd>
				</div>
			))
		}
	</dl>
</section>
