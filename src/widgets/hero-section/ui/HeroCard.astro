---
import ProfileAvatar from '@entities/profile/ui/ProfileAvatar.astro';
import type { HeroCardProps } from '@widgets/hero-section/model/types';
import './HeroCard.css';

type Props = HeroCardProps;

const { profile, availability, primaryAction } = Astro.props;
---

<div class="hero-card__content hero-card__content--compact">
	<div class="hero-card__identity--compact grid w-full grid-cols-1 items-center gap-3 md:gap-4 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-center lg:gap-5">
		<div class="hero-card__header">
			<div class="hero-card__avatar-wrapper">
				<ProfileAvatar
					src={profile.avatar.url}
					alt={profile.avatar.alt}
					brandLogoLightSrc={profile.logo.lightUrl}
					brandLogoDarkSrc={profile.logo.darkUrl}
				/>
			</div>
		</div>

		<div class="hero-card__body">
			<h1
				id="hero-heading"
				class="font-display m-0 text-center text-[1.625rem] font-extrabold leading-tight text-channel-content-strong sm:text-[1.75rem] lg:text-left lg:text-[2rem] xl:text-[2.125rem]">
				{profile.name}
			</h1>
			{profile.tagline && <p class="hero-card__tagline">{profile.tagline}</p>}
			<div class="hero-card__identity-actions">
				{availability && (
					<p class="hero-card__availability">
						<span class="hero-card__availability-indicator" aria-hidden="true" />
						<span class="hero-card__availability-text">{availability}</span>
					</p>
				)}
				{primaryAction && (
					<a
						class="hero-card__primary-action"
						href={primaryAction.href}
						target={primaryAction.external ? '_blank' : undefined}
						rel={primaryAction.external ? 'noopener noreferrer' : undefined}
						data-conversion-event={primaryAction.conversionEvent}
						data-conversion-position="hero"
						data-conversion-item={primaryAction.conversionItem}>
						{primaryAction.label}
					</a>
				)}
			</div>
		</div>
	</div>
</div>
