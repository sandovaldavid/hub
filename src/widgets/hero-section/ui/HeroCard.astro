---
import ProfileAvatar from '@entities/profile/ui/ProfileAvatar.astro';
import type { HeroCardProps } from '../model/types';
import './HeroCard.css';
import { cn } from '@shared/lib';
import CheckIcon from '@shared/assets/check.svg';

interface Props extends HeroCardProps {}

const { profile, variant = 'default' } = Astro.props;
---

<div class="hero-card__content">
	<!-- Avatar + Username (horizontal en desktop) -->
	<div class="hero-card__header">
		<div
			class="hero-card__avatar-wrapper"
			role="img"
			aria-label={`Foto de perfil de ${profile.name}`}>
			<ProfileAvatar
				src={profile.avatar.url}
				alt={profile.avatar.alt}
				size={variant === 'compact' ? 'lg' : '3xl'}
			/>
			<span
				class={cn(
					'hero-card__username',
					'text-primary-600 text-sm md:text-base lg:text-lg font-google font-semibold italic px-3 py-1.5 md:px-4 md:py-2',
					'bg-gray-500/20 flex items-center gap-2 w-fit',
					'border border-primary-500/60 rounded-full shadow-md',
					'transition-colors duration-200 hover:bg-gray-500/50 dark:hover:bg-gray-500/30'
				)}>
				@{profile.displayName}
				<CheckIcon
					class="size-4 md:size-5 lg:size-6 text-sky-500 inline-block"
					aria-hidden="true"
				/>
			</span>
		</div>
	</div>

	<!-- Name, Tagline, Bio (vertical block) -->
	<div class="hero-card__body">
		<h2
			id="hero-heading"
			class={cn(
				'font-display text-xl md:text-2xl lg:text-3xl xl:text-4xl font-extrabold leading-tight',
				'text-gray-900 dark:text-gray-50 m-0'
			)}>
			{profile.name}
		</h2>
		
		{profile.tagline && (
			<p class="hero-card__tagline">
				{profile.tagline}
			</p>
		)}

		{
			variant === 'default' && profile.bio && (
				<p class="hero-card__bio">{profile.bio}</p>
			)
		}
	</div>
</div>
