---
import ProfileAvatar from '@entities/profile/ui/ProfileAvatar.astro';
import type { HeroCardProps } from '../model/types';
import './HeroCard.css';
import { cn } from '@shared/lib';
import CheckIcon from '@shared/assets/check.svg';

type Props = HeroCardProps;

const { profile, variant = 'default', availability, metadata = [], primaryAction } = Astro.props;
const isCompact = variant === 'compact';
---

<div class={cn('hero-card__content', isCompact && 'hero-card__content--compact')}>
	<div
		class={cn(
			'grid w-full grid-cols-1 items-center gap-3 md:gap-4 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-start lg:gap-4',
			isCompact && 'hero-card__identity--compact'
		)}>
		<div class="hero-card__header">
			<div
				class="hero-card__avatar-wrapper"
				role="img"
				aria-label={`Profile photo of ${profile.name}`}>
				<ProfileAvatar
					src={profile.avatar.url}
					alt={profile.avatar.alt}
					brandLogoSrc={profile.logo.url}
					size={isCompact ? '2xl' : '4xl'}
				/>
				<span
					class={cn(
						'hero-card__username font-google flex w-fit items-center gap-2 rounded-full border border-primary-500/60 bg-gray-500/20 font-semibold italic text-primary-600 shadow-md transition-colors duration-200 hover:bg-gray-500/50 dark:hover:bg-gray-500/30',
						isCompact
							? 'px-2.5 py-1 text-xs md:px-3 md:py-1.5 md:text-sm'
							: 'px-3 py-1.5 text-sm md:px-4 md:py-2 md:text-base'
					)}>
					@{profile.displayName}
					<CheckIcon
						class={cn('inline-block text-sky-500', isCompact ? 'size-4' : 'size-4 md:size-5')}
						aria-hidden="true"
					/>
				</span>
			</div>
		</div>

		<div class="hero-card__body">
			<h1
				id="hero-heading"
				class={cn(
					'font-display m-0 font-extrabold leading-tight text-gray-900 dark:text-gray-50',
					isCompact
						? 'text-2xl md:text-[1.75rem] lg:text-[1.875rem] xl:text-[2rem]'
						: 'text-2xl md:text-3xl lg:text-[2.1rem] xl:text-[2.25rem] 2xl:text-[2.5rem]'
				)}>
				{profile.name}
			</h1>

			{profile.tagline && <p class="hero-card__tagline">{profile.tagline}</p>}

			{
				isCompact ? (
					<div class="hero-card__identity-actions">
						{availability && (
							<p class="hero-card__availability">
								<span class="hero-card__availability-indicator" aria-hidden="true" />
								<span class="hero-card__availability-text">{availability}</span>
							</p>
						)}
						{primaryAction && (
							<a
								class="hero-card__primary-action"
								href={primaryAction.href}
								target={primaryAction.external ? '_blank' : undefined}
								rel={primaryAction.external ? 'noopener noreferrer' : undefined}>
								{primaryAction.label}
							</a>
						)}
					</div>
				) : (
					availability && (
						<p class="hero-card__availability">
							<span class="hero-card__availability-indicator" aria-hidden="true" />
							<span class="hero-card__availability-text">{availability}</span>
						</p>
					)
				)
			}
		</div>
	</div>

	{variant === 'default' && profile.bio && <p class="hero-card__bio">{profile.bio}</p>}

	{
		metadata.length > 0 && (
			<dl class="hero-card__metadata">
				{metadata.map(item => (
					<div class="hero-card__metadata-item">
						<dt>{item.label}</dt>
						<dd>{item.value}</dd>
					</div>
				))}
			</dl>
		)
	}

	{
		!isCompact && primaryAction && (
			<a
				class="hero-card__primary-action"
				href={primaryAction.href}
				target={primaryAction.external ? '_blank' : undefined}
				rel={primaryAction.external ? 'noopener noreferrer' : undefined}>
				{primaryAction.label}
			</a>
		)
	}
</div>
