---
import type { SkillsSectionProps } from '../model/types';
import { cn } from '@shared/lib/utils';

type Props = SkillsSectionProps;

const { skills, title = 'Tecnologías', variant: _variant = 'compact' } = Astro.props;
---

<div
	class={cn(
		'skills-card',
		'w-full h-full',
		'bg-white/70 dark:bg-neutral-950/70',
		'border border-white/30 dark:border-white/10',
		'backdrop-blur-xl rounded-xl',
		'p-4 md:p-5 lg:p-7',
		'shadow-md dark:shadow-lg'
	)}>
	<h3
		class={cn(
			'text-sm md:text-base lg:text-lg xl:text-xl font-bold mb-3 md:mb-4 lg:mb-5',
			'text-neutral-900 dark:text-neutral-100'
		)}>
		{title}
	</h3>
	<div class="flex flex-wrap items-center justify-center gap-2 md:gap-4 lg:gap-5 xl:gap-6">
		{
			skills.map(skill => (
				<div
					class={cn(
						'flex flex-col items-center gap-1 md:gap-2 group',
						'transition-all duration-300 ease-out',
						'hover:scale-110 hover:-translate-y-1'
					)}
					title={skill.name}>
					<div
						class={cn(
							'flex items-center justify-center',
							'w-10 h-10 md:w-12 md:h-12 lg:w-14 lg:h-14 xl:w-16 xl:h-16',
							'bg-white dark:bg-neutral-900',
							'border-2 border-neutral-200 dark:border-neutral-700',
							'rounded-lg md:rounded-xl shadow-sm',
							'transition-all duration-300',
							'group-hover:shadow-lg group-hover:border-primary-500'
						)}>
						<span
							class="size-6 md:size-8 lg:size-10 text-gray-950 dark:text-gray-50 transition-colors duration-300 flex items-center justify-center"
							set:html={skill.icon}
						/>
					</div>
					<span
						class={cn(
							'text-[0.625rem] md:text-xs lg:text-sm font-medium',
							'text-neutral-700 dark:text-neutral-300',
							'group-hover:text-primary-600 dark:group-hover:text-primary-400',
							'transition-colors duration-300',
							'text-center leading-tight'
						)}>
						{skill.name}
					</span>
				</div>
			))
		}
	</div>
</div>
