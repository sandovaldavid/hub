---
import type { SkillsSectionProps } from '../model/types';
import { cn } from '@shared/lib/utils';

type Props = SkillsSectionProps;

const { skills, title = 'Tecnologías', variant: _variant = 'compact' } = Astro.props;
---

<div
	class={cn(
		'skills-card',
		'w-full h-full',
		'bg-white/70 dark:bg-neutral-950/70',
		'border border-white/30 dark:border-white/10',
		'backdrop-blur-xl rounded-xl',
		'p-4 md:p-5 lg:p-6',
		'shadow-md dark:shadow-lg'
	)}>
	<h3
		class={cn(
			'mb-4 text-sm font-bold md:mb-5 md:text-base lg:text-lg',
			'text-neutral-900 dark:text-neutral-100'
		)}>
		{title}
	</h3>
	<div
		class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 md:gap-4 lg:grid-cols-8 xl:grid-cols-9 2xl:grid-cols-10">
		{
			skills.map(skill => (
				<div
					class={cn(
						'group flex min-w-0 flex-col items-center gap-1 md:gap-2',
						'transition-all duration-300 ease-out',
						'hover:-translate-y-1 hover:scale-105'
					)}
					data-skill-item
					title={skill.name}>
					<div
						class={cn(
							'flex items-center justify-center',
							'h-10 w-10 md:h-12 md:w-12 lg:h-14 lg:w-14',
							'bg-white dark:bg-neutral-900',
							'border-2 border-neutral-200 dark:border-neutral-700',
							'rounded-lg md:rounded-xl shadow-sm',
							'transition-all duration-300',
							'group-hover:border-primary-500 group-hover:shadow-lg'
						)}>
						<span
							class="flex size-6 items-center justify-center text-gray-950 transition-colors duration-300 md:size-8 lg:size-10 dark:text-gray-50"
							set:html={skill.icon}
						/>
					</div>
					<span
						class={cn(
							'w-full break-words text-center text-[0.625rem] font-medium leading-tight md:text-xs lg:text-sm',
							'text-neutral-700 dark:text-neutral-300',
							'group-hover:text-primary-600 dark:group-hover:text-primary-400',
							'transition-colors duration-300'
						)}>
						{skill.name}
					</span>
				</div>
			))
		}
	</div>
</div>
