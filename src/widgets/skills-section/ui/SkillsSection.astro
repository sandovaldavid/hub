---
import type { SkillsSectionProps } from '../model/types';
import { cn } from '@shared/lib/utils';

type Props = SkillsSectionProps;

const { skills, title = 'Tecnologías', variant: _variant = 'compact' } = Astro.props;
---

<div
	class={cn(
		'skills-card h-full w-full rounded-xl border p-4 shadow-sm backdrop-blur-xl md:p-5 lg:p-6',
		'bg-card-background border-card-edge'
	)}>
	<h2
		id="skills-heading"
		class={cn(
			'mb-4 text-lg font-bold leading-tight md:mb-5 md:text-xl',
			'text-channel-content-strong'
		)}>
		{title}
	</h2>
	<div
		class="grid grid-cols-4 gap-x-2 gap-y-4 sm:grid-cols-5 sm:gap-x-3 md:grid-cols-7 md:gap-4 lg:grid-cols-9 xl:grid-cols-10">
		{
			skills.map(skill => (
				<div
					class={cn(
						'group flex min-w-0 flex-col items-center gap-1 md:gap-2',
						'transition-all duration-300 ease-out hover:-translate-y-0.5'
					)}
					data-skill-item
					title={skill.name}>
					<div
						class={cn(
							'flex items-center justify-center',
							'h-10 w-10 md:h-12 md:w-12 lg:h-14 lg:w-14',
							'rounded-lg border-2 shadow-xs transition-all duration-300 md:rounded-xl',
							'bg-channel-surface-default border-channel-edge-default',
							'group-hover:border-channel-accent-primary group-hover:shadow-retro-xs'
						)}>
						<span
							class="flex size-6 items-center justify-center text-channel-content-strong transition-colors duration-300 md:size-8 lg:size-10"
							set:html={skill.icon}
						/>
					</div>
					<span
						class={cn(
							'w-full break-words text-center text-[0.625rem] font-medium leading-tight md:text-xs lg:text-sm',
							'text-channel-content-muted group-hover:text-channel-accent-primary',
							'transition-colors duration-300'
						)}>
						{skill.name}
					</span>
				</div>
			))
		}
	</div>
</div>
