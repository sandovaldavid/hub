---
import type { SkillsSectionProps } from '../model/types';
import { cn } from '@shared/lib/utils';

interface Props extends SkillsSectionProps {}

const { skills, title = 'Tecnologías', variant = 'compact' } = Astro.props;
---

<div
	class={cn(
		'skills-card',
		'w-full h-full',
		'bg-white/70 dark:bg-neutral-950/70',
		'border border-white/30 dark:border-white/10',
		'backdrop-blur-xl rounded-xl',
		'p-5 md:p-6 lg:p-7',
		'shadow-md dark:shadow-lg'
	)}>
	<h3
		class={cn(
			'text-base md:text-lg lg:text-xl font-bold mb-4 lg:mb-5',
			'text-neutral-900 dark:text-neutral-100'
		)}>
		{title}
	</h3>
	<div class="flex flex-wrap items-center justify-center gap-4 md:gap-5 lg:gap-6">
		{
			skills.map(skill => (
				<div
					class={cn(
						'flex flex-col items-center gap-2 group',
						'transition-all duration-300 ease-out',
						'hover:scale-110 hover:-translate-y-1'
					)}
					title={skill.name}>
					<div
						class={cn(
							'flex items-center justify-center',
							'w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16',
							'bg-white dark:bg-neutral-900',
							'border-2 border-neutral-200 dark:border-neutral-700',
							'rounded-xl shadow-sm',
							'transition-all duration-300',
							'group-hover:shadow-lg group-hover:border-primary-500'
						)}>
						<span
							class="w-7 h-7 md:w-8 md:h-8 lg:w-9 lg:h-9 text-gray-950 dark:text-gray-50 transition-colors duration-300 flex items-center justify-center"
							set:html={skill.icon}
						/>
					</div>
					<span
						class={cn(
							'text-xs md:text-sm font-medium',
							'text-neutral-700 dark:text-neutral-300',
							'group-hover:text-primary-600 dark:group-hover:text-primary-400',
							'transition-colors duration-300'
						)}>
						{skill.name}
					</span>
				</div>
			))
		}
	</div>
</div>
