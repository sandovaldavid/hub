---
import { cn } from '@shared/lib/utils';
import './CTAButtons.css';
import ArrowIcon from '@shared/assets/arrow-right-filled.svg';
import type { CtaIcon, LocalizedCtaButton } from '@shared/model/cta';

import PortfolioIcon from '@shared/assets/owned-destination/portfolio.svg?raw';
import BriefcaseIcon from '@shared/assets/cta-icons/briefcase.svg?raw';

interface Props {
	buttons: LocalizedCtaButton[];
	layout?: 'horizontal' | 'vertical';
}

const { buttons, layout = 'horizontal' } = Astro.props;
const iconMap: Record<CtaIcon, string> = {
	portfolio: PortfolioIcon,
	briefcase: BriefcaseIcon,
};
---

<div class={cn('cta-buttons', layout === 'vertical' && 'cta-buttons--vertical')}>
	{
		buttons.map(button => (
			<a
				href={button.href}
				class="cta-buttons__link group"
				target={button.external ? '_blank' : undefined}
				rel={button.external ? 'noopener noreferrer' : undefined}
				data-conversion-event={button.conversionEvent}
				data-conversion-position="primary-cta"
				data-conversion-item={button.id}
				aria-label={`${button.label}: ${button.description ?? button.title}`}>
				<div
					class={cn(
						'cta-button-card',
						button.variant === 'primary' && 'cta-button-card--primary button-primary',
						button.variant === 'secondary' && 'cta-button-card--secondary'
					)}
					data-work-route-card
					data-route-id={button.id}>
					<div class="cta-button-card__icon-shell" aria-hidden="true">
						<span class="cta-button-card__icon" set:html={iconMap[button.icon]} />
					</div>
					<div class="cta-button-card__content">
						<h3 class="cta-button-card__title">{button.title}</h3>
						{button.description && <p class="cta-button-card__description">{button.description}</p>}
					</div>
					<span class="cta-button-card__action button-secondary" aria-hidden="true">
						<span>{button.label}</span>
						<ArrowIcon class="cta-button-card__arrow" />
					</span>
				</div>
			</a>
		))
	}
</div>
