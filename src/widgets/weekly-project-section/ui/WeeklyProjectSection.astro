---
import { WeeklyProjectCard } from '@entities/weekly-project';
import type { WeeklyProject } from '@entities/weekly-project';
import './WeeklyProjectSection.css';
import Rocket from '@shared/assets/rocket.svg';

interface Props {
	projects: WeeklyProject[];
	lang: 'en' | 'es';
}

const { projects, lang } = Astro.props;
const copy =
	lang === 'es'
		? {
				title: 'Proyectos destacados',
				description:
					'Casos seleccionados que muestran el problema, las decisiones técnicas y el resultado de mi trabajo.',
			}
		: {
				title: 'Featured projects',
				description:
					'Selected cases showing the problem, technical decisions and outcome of my work.',
			};
---

<section class="weekly-project-section" aria-labelledby="featured-projects-title">
	<div class="weekly-project-section__header">
		<div class="flex items-center justify-center gap-2 md:gap-3">
			<h2 id="featured-projects-title" class="weekly-project-section__title">{copy.title}</h2>
			<Rocket class="size-7 md:size-8" aria-hidden="true" />
		</div>
		<p class="weekly-project-section__subtitle">{copy.description}</p>
	</div>

	<div class="weekly-project-section__content" data-project-count={projects.length}>
		{
			projects.map((project, index) => (
				<WeeklyProjectCard {project} {lang} position={index + 1} />
			))
		}
	</div>
</section>
