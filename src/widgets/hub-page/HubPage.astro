---
import Layout from '@app/layouts/Layout.astro';
import { HeroCard, ProfileSnapshot } from '@widgets/hero-section';
import CTAButtons from '@widgets/cta-section/ui/CTAButtons.astro';
import SocialGrid from '@widgets/social-grid/ui/SocialGrid.astro';
import ContactCTA from '@widgets/contact-cta/ui/ContactCTA.astro';
import { SkillsSection } from '@widgets/skills-section';
import WeeklyProjectSection from '@widgets/weekly-project-section/ui/WeeklyProjectSection.astro';

import { profile } from '@data/profile';
import { socialLinks } from '@data/social-links';
import { getCtaButtons } from '@data/cta';
import { skills } from '@data/skills';
import { getFeaturedProjects } from '@data/weekly-project';
import { getSEO } from '@data/seo';
import { siteConfig } from '@data/site.config';
import { getAlternateUrls, useTranslations, type Lang } from '@shared/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const SEO = getSEO(lang);
const alternates = getAlternateUrls(Astro.url);
const projects = getFeaturedProjects(lang);
const professionalSocialLinks = socialLinks.filter(link => link.priority !== 'footer');

const localizedProfile = {
	...profile,
	tagline: t('profile.tagline'),
	bio: t('profile.bio'),
};

const localizedCtaButtons = getCtaButtons().map(btn => ({
	...btn,
	title: t(`cta.${btn.id}.title`),
	description: t(`cta.${btn.id}.description`),
}));

const heroMetadata = [
	{ label: lang === 'es' ? 'Ubicación' : 'Location', value: t('profile.location') },
	{ label: lang === 'es' ? 'Idiomas' : 'Languages', value: t('profile.languages') },
	{ label: lang === 'es' ? 'Modalidad' : 'Work mode', value: t('profile.workMode') },
];
---

<Layout {...SEO} {alternates}>
	<main
		id="main-content"
		tabindex="-1"
		class="hub-container mx-auto flex w-full max-w-384 flex-col gap-6 p-4 md:gap-9 md:px-6 md:py-8 lg:gap-10 lg:px-8 lg:py-10 xl:px-10 xl:py-12"
		role="main"
		aria-label={t('page.mainLabel')}>
		<div
			class="bento-grid flex flex-col gap-4 md:grid md:grid-cols-4 md:items-center md:gap-6 lg:grid-cols-10 lg:gap-7 xl:gap-8"
			data-layout-section="hero"
			role="region"
			aria-label={t('hero.sectionsLabel')}>
			<section
				class="bento-item bento-item--hero min-w-0 md:col-span-2 md:col-start-1 md:row-start-1 md:flex md:rounded-2xl md:border md:border-card-edge md:bg-card-background md:p-4 md:shadow-sm lg:col-span-6 lg:col-start-1 lg:p-5"
				data-layout-column="profile"
				data-layout-panel="profile"
				aria-labelledby="hero-heading">
				<HeroCard
					profile={localizedProfile}
					variant="compact"
					availability={t('profile.availability')}
					primaryAction={{
						label: t('profile.resumeAction'),
						href: siteConfig.resume[lang],
						external: true,
					}}
				/>
			</section>

			<div
				class="bento-item order-2 min-w-0 md:col-span-4 md:row-start-2 lg:col-span-10 lg:row-start-2"
				data-layout-section="profile-snapshot">
				<ProfileSnapshot
					heading={t('profile.snapshotHeading')}
					bio={localizedProfile.bio}
					metadata={heroMetadata}
				/>
			</div>

			<section
				class="bento-item bento-item--social order-3 min-w-0 md:col-span-2 md:col-start-3 md:row-start-1 md:flex md:self-center md:flex-col md:rounded-2xl md:border md:border-card-edge md:bg-card-background md:p-4 md:shadow-sm lg:col-span-4 lg:col-start-7 lg:p-5"
				data-layout-column="social"
				data-layout-panel="social"
				aria-labelledby="social-heading">
				<h2
					id="social-heading"
					class="mb-2 block text-center text-xs font-semibold uppercase tracking-[0.12em] text-channel-accent-primary md:text-left">
					{t('social.heading')}
				</h2>
				<SocialGrid
					links={professionalSocialLinks}
					priorities={['primary', 'secondary']}
					variant="compact"
				/>
			</section>
		</div>

		<section
			class="flex flex-col gap-4 md:gap-6"
			data-layout-section="actions"
			aria-labelledby="cta-heading">
			<header class="bento-item mx-auto max-w-3xl text-center">
				<h2
					id="cta-heading"
					class="m-0 text-2xl font-bold leading-tight text-channel-content-strong md:text-3xl">
					{t('cta.heading')}
				</h2>
				<p class="mx-auto mt-2 text-sm leading-relaxed text-channel-content-muted md:text-base">
					{t('cta.description')}
				</p>
			</header>

			<div class="grid grid-cols-1 gap-4 md:gap-6 lg:grid-cols-3 lg:items-stretch">
				<div
					class="bento-item bento-item--cta flex min-w-0 lg:col-span-2"
					data-layout-column="primary-actions">
					<CTAButtons buttons={localizedCtaButtons} layout="vertical" />
				</div>
				<section
					class="bento-item bento-item--contact flex min-w-0"
					data-layout-column="contact"
					aria-labelledby="contact-heading">
					<ContactCTA email={profile.contact.email} {lang} />
				</section>
			</div>
		</section>

		<section class="bento-item bento-item--weekly-project" data-layout-section="projects">
			<WeeklyProjectSection {projects} {lang} />
		</section>

		<section
			class="bento-item bento-item--skills"
			data-layout-section="skills"
			aria-labelledby="skills-heading">
			<SkillsSection {skills} title={t('skills.title')} />
		</section>
	</main>
</Layout>

<style>
	.bento-item {
		animation: fade-in 0.6s ease-out forwards;
		opacity: 0;
	}

	.bento-item--hero {
		animation-delay: 0.1s;
	}
	.bento-item--social {
		animation-delay: 0.2s;
	}
	.bento-item--cta {
		animation-delay: 0.25s;
	}
	.bento-item--weekly-project {
		animation-delay: 0.35s;
	}
	.bento-item--skills {
		animation-delay: 0.45s;
	}
	.bento-item--contact {
		animation-delay: 0.5s;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bento-item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
