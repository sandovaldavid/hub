---
import { HeroCard, ProfileSnapshot } from '@widgets/hero-section';
import CTAButtons from '@widgets/cta-section/ui/CTAButtons.astro';
import SocialGrid from '@widgets/social-grid/ui/SocialGrid.astro';
import ContactCTA from '@widgets/contact-cta/ui/ContactCTA.astro';
import { SkillsSection } from '@widgets/skills-section';
import FeaturedProjectSection from '@widgets/featured-project-section/ui/FeaturedProjectSection.astro';

import { profile } from '@data/profile';
import { socialLinks } from '@data/social-links';
import { getCtaButtons } from '@data/cta';
import { coreSkills, toolingSkills } from '@data/skills';
import { getFeaturedProjects } from '@data/featured-projects';
import { siteConfig } from '@data/site.config';
import { useTranslations, type Lang } from '@shared/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = getFeaturedProjects(lang);
const professionalSocialLinks = socialLinks.filter(link => link.priority !== 'footer');

const localizedProfile = {
	...profile,
	avatar: { ...profile.avatar, alt: t('profile.avatarAlt') },
	tagline: t('profile.tagline'),
	bio: t('profile.bio'),
};

const localizedCtaButtons = getCtaButtons(t('contact.emailSubject')).map(button => ({
	...button,
	title: t(`cta.${button.id}.title`),
	description: t(`cta.${button.id}.description`),
}));

const heroMetadata = [
	{ label: t('profile.locationLabel'), value: t('profile.location') },
	{ label: t('profile.languagesLabel'), value: t('profile.languages') },
	{ label: t('profile.workModeLabel'), value: t('profile.workMode') },
];
---

<main
	id="main-content"
	tabindex="-1"
	class="hub-container mx-auto flex w-full max-w-384 flex-col gap-6 p-4 md:gap-9 md:px-6 md:py-8 lg:gap-10 lg:px-8 lg:py-10 xl:px-10 xl:py-12"
	role="main"
	aria-label={t('page.mainLabel')}>
	<div
		class="bento-grid flex flex-col gap-4 md:grid md:grid-cols-4 md:items-center md:gap-6 lg:grid-cols-10 lg:gap-7 xl:gap-8"
		data-layout-section="hero"
		role="region"
		aria-label={t('hero.sectionsLabel')}>
		<section
			class="bento-item min-w-0 md:col-span-2 md:col-start-1 md:row-start-1 md:flex md:rounded-2xl md:border md:border-card-edge md:bg-card-background md:p-4 md:shadow-sm lg:col-span-6 lg:col-start-1 lg:p-5"
			data-layout-column="profile"
			data-layout-panel="profile"
			aria-labelledby="hero-heading">
			<HeroCard
				profile={localizedProfile}
				variant="compact"
				availability={t('profile.availability')}
				primaryAction={{
					label: t('profile.resumeAction'),
					href: siteConfig.resume[lang],
					external: true,
					conversionEvent: 'resume_downloaded',
					conversionItem: 'resume',
				}}
			/>
		</section>

		<div
			class="bento-item order-2 min-w-0 md:col-span-4 md:row-start-2 lg:col-span-10 lg:row-start-2"
			data-layout-section="profile-snapshot">
			<ProfileSnapshot
				heading={t('profile.snapshotHeading')}
				bio={localizedProfile.bio}
				metadata={heroMetadata}
			/>
		</div>

		<section
			class="bento-item order-3 min-w-0 md:col-span-2 md:col-start-3 md:row-start-1 md:flex md:self-center md:flex-col md:rounded-2xl md:border md:border-card-edge md:bg-card-background md:p-4 md:shadow-sm lg:col-span-4 lg:col-start-7 lg:p-5"
			data-layout-column="social"
			data-layout-panel="social"
			aria-labelledby="social-heading">
			<h2
				id="social-heading"
				class="mb-2 block text-center text-xs font-semibold uppercase tracking-[0.12em] text-channel-accent-primary md:text-left">
				{t('social.heading')}
			</h2>
			<SocialGrid
				links={professionalSocialLinks}
				priorities={['primary', 'secondary']}
				variant="compact"
				{lang}
			/>
		</section>
	</div>

	<section
		class="flex flex-col gap-4 md:gap-6"
		data-layout-section="actions"
		aria-labelledby="cta-heading">
		<header class="bento-item mx-auto max-w-3xl text-center">
			<h2
				id="cta-heading"
				class="m-0 text-2xl font-bold leading-tight text-channel-content-strong md:text-3xl">
				{t('cta.heading')}
			</h2>
			<p class="mx-auto mt-2 text-sm leading-relaxed text-channel-content-muted md:text-base">
				{t('cta.description')}
			</p>
		</header>

		<div class="grid grid-cols-1 gap-4 md:gap-6 lg:grid-cols-3 lg:items-stretch">
			<div class="bento-item flex min-w-0 lg:col-span-2" data-layout-column="primary-actions">
				<CTAButtons buttons={localizedCtaButtons} layout="vertical" />
			</div>
			<section
				class="bento-item flex min-w-0"
				data-layout-column="contact"
				aria-labelledby="contact-heading">
				<ContactCTA email={profile.contact.email} {lang} />
			</section>
		</div>
	</section>

	<section class="bento-item" data-layout-section="projects">
		<FeaturedProjectSection {projects} {lang} />
	</section>

	<section class="bento-item" data-layout-section="skills" aria-labelledby="skills-heading">
		<SkillsSection
			{coreSkills}
			{toolingSkills}
			title={t('skills.title')}
			coreTitle={t('skills.coreTitle')}
			toolsTitle={t('skills.toolsTitle')}
		/>
	</section>
</main>

<style>
	/*
	 * Scroll-driven reveal: sections fade and lift in as they enter the
	 * scrollport and settle back out as they leave. `view()` is driven by
	 * scroll position rather than a pointer state, so nothing can be left
	 * stuck mid-animation after a tap on a touch screen.
	 *
	 * No fixed `opacity: 0` base: an element already in view at load sits
	 * past `entry 100%`, so above-the-fold content paints opaque on the
	 * first frame and does not hold back the LCP.
	 */
	/*
	 * Longhands, deliberately: the CSS minifier folds `animation` +
	 * `animation-timeline` into the shorthand, and Chrome does not accept
	 * `view()` there — the timeline is silently dropped and nothing animates.
	 */
	.bento-item {
		animation-name: bento-reveal;
		animation-duration: 1ms;
		animation-timing-function: linear;
		animation-fill-mode: both;
		animation-timeline: view();
	}

	@keyframes bento-reveal {
		entry 0% {
			opacity: 0;
			transform: translateY(1.25rem);
		}
		entry 100% {
			opacity: 1;
			transform: none;
		}
		exit 0% {
			opacity: 1;
			transform: none;
		}
		exit 100% {
			opacity: 0;
			transform: translateY(-1.25rem);
		}
	}

	/* Browsers without scroll-driven animations render the content plainly. */
	@supports not (animation-timeline: view()) {
		.bento-item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bento-item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
