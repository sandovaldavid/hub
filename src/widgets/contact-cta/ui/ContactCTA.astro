---
import Card from '@shared/ui/Card.astro';
import Button from '@shared/ui/Button.astro';
import type { ContactCTAProps } from '../model/types';
import { cn } from '@shared/lib/utils';
import ChatIcon from '@shared/assets/cta-icons/chat.svg?raw';
import SentIcon from '@shared/assets/sent.svg';

export type Props = ContactCTAProps;

const {
	title = '¿Tienes un proyecto en mente?',
	message = 'Hablemos sobre cómo puedo ayudarte a alcanzar tus objetivos',
	buttonText = 'Hablemos',
	email,
	subject = 'Consulta desde Hub Personal',
	variant = 'default',
} = Astro.props;

const mailtoLink = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<Card
	variant={variant === 'prominent' ? 'gradient' : 'default'}
	padding="none"
	class={cn(
		'contact-cta relative flex h-full w-full overflow-hidden',
		'bg-white/80 backdrop-blur-lg',
		'border-2 border-primary-100',
		'rounded-2xl shadow-lg',
		'dark:bg-neutral-900/30 dark:border-primary-700'
	)}>
	<div
		class={cn(
			'flex h-full min-w-0 flex-1 flex-col items-center justify-center gap-4 px-5 py-6 text-center',
			'sm:px-8 md:px-6 lg:px-7'
		)}>
		<div
			class={cn(
				'flex items-center justify-center rounded-full',
				'h-11 w-11 bg-primary-100 shadow-md md:h-12 md:w-12',
				'dark:bg-primary-950'
			)}
			aria-hidden="true">
			<span
				class="inline-block h-7 w-7 text-primary-600 md:h-8 md:w-8 dark:text-primary-300"
				set:html={ChatIcon}
			/>
		</div>
		<div class="flex min-w-0 max-w-xl flex-col gap-2">
			<h2
				id="contact-heading"
				class={cn(
					'm-0 break-words text-lg font-bold leading-tight md:text-xl',
					'text-neutral-900 dark:text-neutral-100'
				)}>
				{title}
			</h2>
			{
				message && (
					<p
						class={cn(
							'm-0 break-words text-sm leading-relaxed md:text-base',
							'text-neutral-700 dark:text-neutral-300'
						)}>
						{message}
					</p>
				)
			}
		</div>
		<a
			href={mailtoLink}
			class="w-full max-w-xs"
			data-conversion-event="contact_clicked"
			data-conversion-position="contact"
			data-conversion-item="email"
			aria-label={`Enviar correo a ${email}: ${subject}`}>
			<Button
				variant="primary"
				size="lg"
				class="flex w-full cursor-pointer items-center justify-center gap-2 font-semibold">
				<span>{buttonText}</span>
				<SentIcon
					class="h-5 w-5"
					aria-hidden="true"
				/>
			</Button>
		</a>
	</div>
</Card>
