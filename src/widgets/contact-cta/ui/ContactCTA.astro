---
import ChatIcon from '@shared/assets/cta-icons/chat.svg?raw';
import { useTranslations, type Lang } from '@shared/i18n';
import WorkRouteCard from '@widgets/cta-section/ui/WorkRouteCard.astro';

interface Props {
	lang?: Lang;
	title?: string;
	message?: string;
	buttonText?: string;
	email: string;
	subject?: string;
}

const { lang = 'en', email } = Astro.props;
const t = useTranslations(lang);
const subject = Astro.props.subject ?? t('contact.emailSubject');
const title = Astro.props.title ?? t('contact.title');
const message = Astro.props.message ?? t('contact.message');
const buttonText = Astro.props.buttonText ?? t('contact.buttonText');
const mailtoLink = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<WorkRouteCard
	id="contact"
	{title}
	description={message}
	href={mailtoLink}
	actionLabel={buttonText}
	icon={ChatIcon}
	actionIcon="email"
	conversionEvent="contact_clicked"
	conversionPosition="contact"
	conversionItem="email"
	headingId="contact-heading"
	ariaLabel={`${buttonText}: ${email}`}
/>
