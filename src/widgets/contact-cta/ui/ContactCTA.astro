---
import Card from '@shared/ui/Card.astro';
import Button from '@shared/ui/Button.astro';
import type { ContactCTAProps } from '../model/types';
import { cn } from '@shared/lib/utils';
import ChatIcon from '@shared/assets/cta-icons/chat.svg?raw';
import SentIcon from '@shared/assets/sent.svg';

export type Props = ContactCTAProps;

const {
	title = '¿Tienes un proyecto en mente?',
	message = 'Hablemos sobre cómo puedo ayudarte a alcanzar tus objetivos',
	buttonText = 'Hablemos',
	email,
	subject = 'Consulta desde Hub Personal',
	variant = 'default',
} = Astro.props;

const mailtoLink = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
---

<Card
	variant={variant === 'prominent' ? 'gradient' : 'default'}
	padding="none"
	class={cn(
		'contact-cta relative flex h-full w-full overflow-hidden lg:min-h-40',
		'bg-card-background border border-card-edge-accent rounded-2xl shadow-sm backdrop-blur-lg'
	)}>
	<div
		class={cn(
			'flex h-full min-w-0 flex-1 flex-col items-center justify-center gap-2.5 px-5 py-4 text-center',
			'sm:px-6 md:px-5 lg:px-5'
		)}>
		<div
			class={cn(
				'flex size-9 items-center justify-center rounded-full border shadow-xs',
				'bg-badge-brand-background border-badge-brand-edge'
			)}
			aria-hidden="true">
			<span class="inline-block size-5 text-channel-accent-primary" set:html={ChatIcon} />
		</div>
		<div class="flex min-w-0 max-w-xl flex-col gap-1.5">
			<h3
				id="contact-heading"
				class={cn(
					'm-0 break-words text-base font-bold leading-tight',
					'text-channel-content-strong'
				)}>
				{title}
			</h3>
			{
				message && (
					<p
						class={cn(
							'm-0 break-words text-xs leading-relaxed md:text-sm',
							'text-channel-content-default'
						)}>
						{message}
					</p>
				)
			}
		</div>
		<a
			href={mailtoLink}
			class="w-full max-w-xs"
			data-conversion-event="contact_clicked"
			data-conversion-position="contact"
			data-conversion-item="email"
			aria-label={`Enviar correo a ${email}: ${subject}`}>
			<Button
				variant="primary"
				size="md"
				class="flex w-full cursor-pointer items-center justify-center gap-2 font-semibold">
				<span>{buttonText}</span>
				<SentIcon class="h-4 w-4" aria-hidden="true" />
			</Button>
		</a>
	</div>
</Card>
