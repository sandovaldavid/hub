---
import '@shared/styles/global.css';
import { getThemeInitScript } from '@entities/theme/lib/theme-manager';
import ShareButton from '@features/share-button/ui/ShareButton.astro';
import ThemeToggle from '@features/theme-toggle/ui/ThemeToggle.astro';
import LanguageToggle from '@features/language-toggle/ui/LanguageToggle.astro';
import SiteFooter from '@widgets/site-footer/ui/SiteFooter.astro';
import type { SEOProps } from '@data/seo';
import Analytics from '@vercel/analytics/astro';
import { siteConfig } from '@data/site.config';
import { getProfilePageStructuredData } from '@data/structured-data';
import { useTranslations } from '@shared/i18n';
import { Font } from 'astro:assets';

interface Props extends SEOProps {
	alternates?: { en: string; es: string };
	emitCanonical?: boolean;
	emitStructuredData?: boolean;
	showShare?: boolean;
	showLanguageToggle?: boolean;
}

const {
	title,
	description,
	author,
	ogImage,
	themeColor,
	applicationName,
	appleMobileWebAppTitle,
	ogType,
	ogImageAlt,
	ogImageSecureUrl,
	ogImageType,
	ogImageWidth,
	ogImageHeight,
	ogSiteName,
	fbAppId,
	ogLocale,
	twitterCard,
	twitterSite,
	twitterCreator,
	twitterImageAlt,
	twitterLabel1,
	twitterData1,
	robots,
	lang,
	alternates,
	emitCanonical = true,
	emitStructuredData = true,
	showShare = true,
	showLanguageToggle = true,
} = Astro.props;

const t = useTranslations(lang);
const themeScript = getThemeInitScript();
const finalCanonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const sitemapUrl = new URL('/sitemap-index.xml', siteConfig.url).href;
const absoluteOgImage = new URL(ogImageSecureUrl ?? ogImage, siteConfig.url).href;
const alternateLocale = ogLocale.startsWith('es_') ? 'en_US' : 'es_PE';
const jsonLd = emitStructuredData
	? getProfilePageStructuredData({
			title,
			description,
			lang,
			canonicalUrl: finalCanonicalUrl,
			imageUrl: absoluteOgImage,
			imageAlt: ogImageAlt,
			portraitAlt: t('profile.avatarAlt'),
		})
	: undefined;
---

<!doctype html>
<html {lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href={sitemapUrl} />

		<!-- Self-hosted from Fontsource at build time; both are above the fold
		     (Inter carries the body copy, JetBrains Mono the h1 and headings). -->
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-jetbrains-mono" preload />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		<meta name="application-name" content={applicationName} />
		<meta name="apple-mobile-web-app-title" content={appleMobileWebAppTitle} />
		<meta name="theme-color" content={themeColor} />
		<meta name="color-scheme" content="light dark" />
		<link id="site-favicon" rel="icon" type="image/svg+xml" href="/favicon.dark.svg" />

		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={finalCanonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteOgImage} />
		<meta property="og:image:secure_url" content={absoluteOgImage} />
		<meta property="og:site_name" content={ogSiteName} />
		<meta property="og:author" content={author} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		{fbAppId && <meta property="fb:app_id" content={fbAppId} />}
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={alternateLocale} />

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={finalCanonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOgImage} />
		<meta name="twitter:site" content={twitterSite} />
		<meta name="twitter:creator" content={twitterCreator} />
		<meta name="twitter:image:alt" content={twitterImageAlt} />
		<meta name="twitter:label1" content={twitterLabel1} />
		<meta name="twitter:data1" content={twitterData1} />

		{
			alternates && (
				<>
					<link rel="alternate" hreflang="en" href={new URL(alternates.en, siteConfig.url)} />
					<link rel="alternate" hreflang="es" href={new URL(alternates.es, siteConfig.url)} />
					<link
						rel="alternate"
						hreflang="x-default"
						href={new URL(alternates.en, siteConfig.url)}
					/>
				</>
			)
		}

		{emitCanonical && <link rel="canonical" href={finalCanonicalUrl} />}
		<meta name="robots" content={robots} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<script is:inline set:html={themeScript} />
		{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body
		class="flex min-h-screen flex-col bg-channel-background-canvas text-channel-content-default">
		<a href="#main-content" class="skip-link">{t('nav.skipToContent')}</a>
		{showShare && <ShareButton {lang} />}
		{showLanguageToggle && <LanguageToggle {lang} {alternates} />}
		<ThemeToggle {lang} />
		<slot />
		<SiteFooter {lang} />
		<Analytics />
		<script>
			import { initConversionAnalytics } from '@shared/analytics/conversion';
			initConversionAnalytics();
		</script>
	</body>
</html>
