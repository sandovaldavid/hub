---
import '../styles/global.css';
import { getThemeInitScript } from '@entities/theme';
import { ShareButton } from '@features/share-button';
import { ThemeToggle } from '@features/theme-toggle';
import type { SEOProps } from '@/app/models/seo.model';
import Analytics from '@vercel/analytics/astro';
import { siteConfig } from '@data/site.config';

interface Props extends SEOProps {
	alternates?: { en: string; es: string };
}

const {
	title,
	description,
	author,
	ogImage,
	themeColor,
	applicationName = siteConfig.name,
	appleMobileWebAppTitle = siteConfig.shortName,
	ogType = 'website',
	ogImageAlt = '',
	ogImageSecureUrl = `${siteConfig.url}/og/og-image.png`,
	ogImageType = 'image/png',
	ogSiteName = siteConfig.name,
	fbAppId = siteConfig.fbAppId,
	ogLocale = 'en_US',
	twitterCard = 'summary_large_image',
	twitterSite = '@dev_sandoval',
	twitterCreator,
	twitterImageAlt = '',
	twitterLabel1 = '',
	twitterData1 = '',
	canonicalUrl,
	robots = 'index, follow',
	googlebot = 'index, follow',
	keywords = [],
	lang = 'en',
	alternates,
} = Astro.props as Props;

const themeScript = getThemeInitScript();
const keywordsContent = keywords.length > 0 ? keywords.join(', ') : undefined;
const finalCanonicalUrl = canonicalUrl || Astro.url.href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'David Sandoval Salvador',
	url: siteConfig.url,
	sameAs: [
		'https://linkedin.com/in/devsandoval',
		'https://github.com/sandovaldavid',
		'https://twitter.com/dev_sandoval',
		'https://youtube.com/@devsandoval',
	],
	jobTitle: 'Web Developer',
	knowsLanguage: ['en', 'es'],
	contactPoint: {
		'@type': 'ContactPoint',
		email: 'contact@devsandoval.com',
		contactType: 'customer support',
	},
};
---

<!doctype html>
<html {lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={author} />
		{keywordsContent && <meta name="keywords" content={keywordsContent} />}
		<meta name="application-name" content={applicationName} />
		<meta name="apple-mobile-web-app-title" content={appleMobileWebAppTitle} />

		<!-- Theme Color -->
		<meta name="theme-color" content={themeColor} />
		<meta name="color-scheme" content="light dark" />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />
		<meta property="og:site_name" content={ogSiteName} />
		<meta property="og:author" content={author} />
		{ogImageSecureUrl && <meta property="og:image:secure_url" content={ogImageSecureUrl} />}
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
		{ogImageType && <meta property="og:image:type" content={ogImageType} />}
		{fbAppId && <meta property="fb:app_id" content={fbAppId} />}
		<meta property="og:locale" content={ogLocale} />

		<!-- Twitter -->
		<meta property="twitter:card" content={twitterCard} />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
		<meta name="twitter:site" content={twitterSite} />
		{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
		{twitterImageAlt && <meta name="twitter:image:alt" content={twitterImageAlt} />}
		{twitterLabel1 && <meta name="twitter:label1" content={twitterLabel1} />}
		{twitterData1 && <meta name="twitter:data1" content={twitterData1} />}

		<!-- Hreflang for multilingual -->
		{
			alternates && (
				<>
					<link rel="alternate" hreflang="en" href={`${siteConfig.url}${alternates.en}`} />
					<link rel="alternate" hreflang="es" href={`${siteConfig.url}${alternates.es}`} />
					<link rel="alternate" hreflang="x-default" href={siteConfig.url} />
				</>
			)
		}

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:ital,wght@0,300..800;1,300..800&display=swap"
			rel="stylesheet"
		/>

		<!-- SEO & Performance -->
		<link rel="canonical" href={finalCanonicalUrl} />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={googlebot} />

		<!-- PWA Tags -->
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- Theme Initialization Script (prevent FOUC) -->
		<script is:inline set:html={themeScript} />

		<!-- JSON-LD Structured Data -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body
		class="bg-linear-to-br from-primary-50 via-primary-100 to-primary-200 dark:bg-linear-to-br dark:from-primary-950 dark:via-primary-900 dark:to-primary-800">
		<!-- Skip Link for Keyboard Navigation -->
		<a href="#main-content" class="skip-link">
			{lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
		</a>

		<!-- Share Button - Fixed Top Left -->
		<ShareButton position="top-left" size="md" />

		<!-- Theme Toggle Button (Floating) -->
		<ThemeToggle variant="floating" size="md" />

		<slot />

		<!-- Analytics — placed at end of body for performance -->
		<Analytics />
	</body>
</html>
