---
import './ShareButton.css';
import ShareIcon from '@shared/assets/share-icon.svg?raw';
import { useTranslations, type Lang } from '@shared/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<button
	id="share-button"
	class="share-button"
	aria-label={t('share.ariaLabel')}
	data-share-label-webshare={t('share.webShareLabel')}
	data-share-label-clipboard={t('share.clipboardLabel')}
	data-share-text={t('share.text')}
	type="button">
	<span class="share-button__icon" aria-hidden="true" set:html={ShareIcon} />
	<span class="share-button__feedback" id="share-feedback">{t('share.copied')}</span>
</button>

<script>
	import { share, isWebShareSupported } from '../lib/share-utils';

	const button = document.getElementById('share-button');
	const feedback = document.getElementById('share-feedback');

	if (button) {
		const webshareLabel = button.getAttribute('data-share-label-webshare') || 'Share site';
		const clipboardLabel = button.getAttribute('data-share-label-clipboard') || 'Copy link';
		const shareText = button.getAttribute('data-share-text') || '';
		const updateAriaLabel = () => {
			button.setAttribute('aria-label', isWebShareSupported() ? webshareLabel : clipboardLabel);
		};

		updateAriaLabel();

		button.addEventListener('click', async () => {
			(button as HTMLButtonElement).disabled = true;
			button.classList.add('share-button--loading');

			try {
				const result = await share(shareText);
				if (result.method === 'clipboard' && result.success && feedback) {
					feedback.classList.add('share-button__feedback--visible');
					setTimeout(() => feedback.classList.remove('share-button__feedback--visible'), 2000);
				}
			} catch (error) {
				console.error('Error during share:', error);
			} finally {
				(button as HTMLButtonElement).disabled = false;
				button.classList.remove('share-button--loading');
			}
		});
	}
</script>
