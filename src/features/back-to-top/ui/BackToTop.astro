---
/**
 * Floating back-to-top control. Hidden until the footer enters the
 * viewport (i.e. the visitor has actually reached the end of the page),
 * then jumps to #main-content — reusing the same smooth-scroll behavior
 * as the skip-link (see global.css `html { scroll-behavior: smooth }`).
 */
import ArrowUpIcon from '@shared/assets/arrow-up.svg?raw';
import { useTranslations, type Lang } from '@shared/i18n';
import './BackToTop.css';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const ariaLabel = t('footer.backToTop');
---

<a
	href="#main-content"
	id="back-to-top"
	class="back-to-top"
	aria-label={ariaLabel}
	data-hidden="true">
	<span class="back-to-top__icon" set:html={ArrowUpIcon} />
</a>

<script>
	const button = document.getElementById('back-to-top');
	const footer = document.getElementById('site-footer');

	if (button && footer) {
		const observer = new IntersectionObserver(
			([entry]) => {
				button.dataset.hidden = entry.isIntersecting ? 'false' : 'true';
			},
			{ threshold: 0 }
		);
		observer.observe(footer);
	}
</script>
