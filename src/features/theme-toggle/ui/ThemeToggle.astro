---
/**
 * Interactive theme toggle button with light/dark/system modes.
 */

import './ThemeToggle.css';

import SunIcon from '@shared/assets/theme-icons/sun.svg?raw';
import MoonIcon from '@shared/assets/theme-icons/moon.svg?raw';
import SystemIcon from '@shared/assets/theme-icons/system.svg?raw';
---

<button
	id="theme-toggle"
	class="theme-toggle"
	aria-label="Cambiar tema"
	title="Cambiar tema"
	type="button">
	<span class="theme-toggle__icon" data-theme-icon="light">
		<Fragment set:html={SunIcon} />
	</span>
	<span class="theme-toggle__icon" data-theme-icon="dark">
		<Fragment set:html={MoonIcon} />
	</span>
	<span class="theme-toggle__icon" data-theme-icon="system">
		<Fragment set:html={SystemIcon} />
	</span>
</button>

<script>
	import { ThemeManager } from '@entities/theme/lib/theme-manager';

	type Theme = 'light' | 'dark' | 'system';
	const THEME_LABELS: Record<Theme, string> = {
		light: 'Modo Claro',
		dark: 'Modo Oscuro',
		system: 'Sistema',
	};

	const button = document.getElementById('theme-toggle');
	const themeManager = new ThemeManager();

	if (button) {
		function updateUI(theme: Theme) {
			if (!button) return;

			const icons = button.querySelectorAll('[data-theme-icon]');
			icons.forEach(icon => {
				(icon as HTMLElement).style.display = 'none';
			});

			const currentIcon = button.querySelector(`[data-theme-icon="${theme}"]`);
			if (currentIcon) {
				(currentIcon as HTMLElement).style.display = 'inline-block';
			}

			button.setAttribute('aria-label', `Tema actual: ${THEME_LABELS[theme]}`);
		}

		const initialState = themeManager.getThemeState();
		updateUI(initialState.current);

		button.addEventListener('click', () => {
			const newState = themeManager.cycleTheme();
			updateUI(newState.current);

			window.dispatchEvent(
				new CustomEvent('theme-change', {
					detail: { theme: newState.current, effective: newState.effective },
				})
			);
		});

		themeManager.watchSystemPreference(systemTheme => {
			const currentTheme = themeManager.getThemeState().current;

			if (currentTheme === 'system') {
				window.dispatchEvent(
					new CustomEvent('theme-change', {
						detail: { theme: 'system', effective: systemTheme },
					})
				);
			}
		});
	}
</script>
