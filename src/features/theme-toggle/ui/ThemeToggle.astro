---
/**
 * Interactive theme toggle button with light/dark/system modes.
 */

import './ThemeToggle.css';

import SunIcon from '@shared/assets/theme-icons/sun.svg?raw';
import MoonIcon from '@shared/assets/theme-icons/moon.svg?raw';
import SystemIcon from '@shared/assets/theme-icons/system.svg?raw';
import { useTranslations, type Lang } from '@shared/i18n';

interface Props {
	lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const initialLabel = t('theme.system');
const labelLight = t('theme.light');
const labelDark = t('theme.dark');
const labelSystem = t('theme.system');
---

<button
	id="theme-toggle"
	class="theme-toggle"
	aria-label={initialLabel}
	data-label-light={labelLight}
	data-label-dark={labelDark}
	data-label-system={labelSystem}
	type="button">
	<span class="theme-toggle__icon" data-theme-icon="light">
		<Fragment set:html={SunIcon} />
	</span>
	<span class="theme-toggle__icon" data-theme-icon="dark">
		<Fragment set:html={MoonIcon} />
	</span>
	<span class="theme-toggle__icon" data-theme-icon="system">
		<Fragment set:html={SystemIcon} />
	</span>
</button>

<script>
	import { ThemeManager } from '@entities/theme/lib/theme-manager';

	type Theme = 'light' | 'dark' | 'system';

	const button = document.getElementById('theme-toggle');
	const themeManager = new ThemeManager();

	if (button) {
		const labels: Record<Theme, string> = {
			light: button.getAttribute('data-label-light') || 'Light mode',
			dark: button.getAttribute('data-label-dark') || 'Dark mode',
			system: button.getAttribute('data-label-system') || 'System preference',
		};

		function updateUI(theme: Theme, animate = false) {
			if (!button) return;

			const icons = button.querySelectorAll('[data-theme-icon]');
			icons.forEach(icon => {
				(icon as HTMLElement).style.display = 'none';
			});

			const currentIcon = button.querySelector(`[data-theme-icon="${theme}"]`);
			if (currentIcon) {
				(currentIcon as HTMLElement).style.display = 'inline-block';

				if (animate) {
					currentIcon.classList.add('theme-toggle__icon--spin');
					currentIcon.addEventListener(
						'animationend',
						() => currentIcon.classList.remove('theme-toggle__icon--spin'),
						{ once: true }
					);
				}
			}

			// aria-label doubles as the visible tooltip content via
			// ThemeToggle.css's `content: attr(aria-label)` — no separate
			// title attribute (that gave an unstyled native tooltip).
			button.setAttribute('aria-label', labels[theme]);
		}

		const initialState = themeManager.getThemeState();
		updateUI(initialState.current);

		button.addEventListener('click', () => {
			const newState = themeManager.cycleTheme();
			updateUI(newState.current, true);

			window.dispatchEvent(
				new CustomEvent('theme-change', {
					detail: { theme: newState.current, effective: newState.effective },
				})
			);
		});

		themeManager.watchSystemPreference(systemTheme => {
			const currentTheme = themeManager.getThemeState().current;

			if (currentTheme === 'system') {
				window.dispatchEvent(
					new CustomEvent('theme-change', {
						detail: { theme: 'system', effective: systemTheme },
					})
				);
			}
		});
	}
</script>
