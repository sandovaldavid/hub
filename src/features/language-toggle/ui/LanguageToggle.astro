---
import { useTranslations, type Lang } from '@shared/i18n';
import './LanguageToggle.css';

interface Props {
	lang: Lang;
	alternates?: { en: string; es: string };
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const targetLang = lang === 'en' ? 'es' : 'en';
const targetUrl = alternates ? alternates[targetLang] : targetLang === 'es' ? '/es/' : '/';
const switchDescription = t('nav.switchLanguage');
const displayLabel = targetLang.toUpperCase();
---

<a
	href={targetUrl}
	class="language-toggle"
	data-conversion-event="language_changed"
	data-conversion-position="navigation"
	data-conversion-item={targetLang}>
	<!--
		No aria-label: overriding the name with a description that omits the
		visible "ES"/"EN" breaks WCAG 2.5.3 Label in Name. Composing the name
		from the visible code plus a visually hidden description keeps the
		visible text inside the accessible name and still says which language
		the link leads to.
	-->
	<span>{displayLabel}</span>
	<span class="sr-only">{switchDescription}</span>
</a>
