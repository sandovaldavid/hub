---
/**
 * Card Component - FSD Layer: shared/ui
 * Link Hub surface primitive with channel-aware variants.
 */

import { cn } from '../lib/utils';

export interface Props {
	variant?: 'default' | 'gradient' | 'glass' | 'outlined';
	padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
	interactive?: boolean;
	href?: string;
	target?: '_blank' | '_self' | '_parent' | '_top';
	class?: string;
}

const {
	variant = 'default',
	padding = 'md',
	interactive = false,
	href,
	target,
	class: className,
	...rest
} = Astro.props;

const baseClasses = 'rounded-2xl transition-all duration-300';

const variantClasses = {
	default: 'bg-card-background border border-card-edge shadow-sm',
	gradient:
		'bg-linear-to-br from-channel-accent-primary to-channel-accent-secondary text-button-primary-content border-0 shadow-sm',
	glass: 'bg-card-background border border-card-edge backdrop-blur-md shadow-sm',
	outlined: 'bg-transparent border-2 border-channel-edge-default',
};

const paddingClasses = {
	none: '',
	sm: 'p-4',
	md: 'p-6',
	lg: 'p-8',
	xl: 'p-10',
};

const interactiveClasses = interactive
	? 'cursor-pointer hover:-translate-y-0.5 hover:shadow-retro-xs active:translate-y-0 active:shadow-none'
	: '';

const cardClasses = cn(
	baseClasses,
	variantClasses[variant],
	paddingClasses[padding],
	interactiveClasses,
	className
);

const isLink = !!href;
const Element = isLink ? 'a' : 'div';
const elementProps = isLink
	? {
			href,
			target,
			rel: target === '_blank' ? 'noopener noreferrer' : undefined,
		}
	: {};
---

<Element class={cardClasses} {...elementProps} {...rest}>
	<slot />
</Element>
