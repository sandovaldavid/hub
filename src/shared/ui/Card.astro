---
/**
 * Card Component - FSD Layer: shared/ui
 * Bento Grid item base with hover effects and gradient support
 */

import { cn } from '../lib/utils';

export interface Props {
	variant?: 'default' | 'gradient' | 'glass' | 'outlined';
	padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
	interactive?: boolean;
	href?: string;
	target?: '_blank' | '_self' | '_parent' | '_top';
	class?: string;
}

const {
	variant = 'default',
	padding = 'md',
	interactive = false,
	href,
	target,
	class: className,
	...rest
} = Astro.props;

const baseClasses = 'rounded-2xl transition-all duration-300';

const variantClasses = {
	default:
		'bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 shadow-sm',
	gradient:
		'bg-gradient-to-br from-primary-600 via-primary-500 to-accent-500 text-white border-0 shadow-lg',
	glass: 'glass backdrop-blur-md shadow-lg',
	outlined:
		'bg-transparent border-2 border-neutral-300 dark:border-neutral-700',
};

const paddingClasses = {
	none: '',
	sm: 'p-4',
	md: 'p-6',
	lg: 'p-8',
	xl: 'p-10',
};

const interactiveClasses = interactive
	? 'hover:scale-105 hover:shadow-xl cursor-pointer active:scale-100'
	: '';

const cardClasses = cn(
	baseClasses,
	variantClasses[variant],
	paddingClasses[padding],
	interactiveClasses,
	className
);

const isLink = !!href;
const Element = isLink ? 'a' : 'div';
const elementProps = isLink
	? {
			href,
			target,
			rel: target === '_blank' ? 'noopener noreferrer' : undefined,
		}
	: {};
---

<Element class={cardClasses} {...elementProps} {...rest}>
	<slot />
</Element>
