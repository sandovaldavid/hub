---
/**
 * Badge Component - FSD Layer: shared/ui
 * Technology tags with color coding and size variants
 */

import { cn } from '../lib/utils';
import './Badge.css';

export interface Props {
	variant?: 'primary' | 'accent' | 'success' | 'warning' | 'error' | 'neutral';
	size?: 'sm' | 'md' | 'lg';
	rounded?: boolean;
	class?: string;
}

const { variant = 'neutral', size = 'md', rounded = true, class: className, ...rest } = Astro.props;

const baseClasses = 'badge-base';

const variantClasses = {
	primary: 'badge-primary',
	accent: 'badge-accent',
	success: 'badge-success',
	warning: 'badge-warning',
	error: 'badge-error',
	neutral: 'badge-neutral',
};

const sizeClasses = {
	sm: 'badge-size-sm',
	md: 'badge-size-md',
	lg: 'badge-size-lg',
};

const roundedClasses = rounded ? 'rounded-full' : 'rounded-md';

const badgeClasses = cn(
	baseClasses,
	variantClasses[variant],
	sizeClasses[size],
	roundedClasses,
	className
);
---

<span class={badgeClasses} {...rest}>
	<slot />
</span>
