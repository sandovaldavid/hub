---
/**
 * Avatar Component - FSD Layer: shared/ui
 * Profile image with an optional ring.
 */

import { cn } from '@shared/lib/utils';
import './Avatar.css';

export interface Props {
	src: string;
	alt: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
	ring?: boolean;
	ringColor?: string;
	class?: string;
}

const {
	src,
	alt,
	loading = 'lazy',
	fetchpriority = loading === 'eager' ? 'high' : 'auto',
	ring = false,
	ringColor = 'ring-channel-accent-primary',
	class: className,
	...rest
} = Astro.props;

// Matches .avatar-size-5xl in Avatar.css.
const AVATAR_DIMENSION = 208;
const ringClasses = ring
	? `ring-2 ring-offset-2 ring-offset-channel-background-canvas ${ringColor}`
	: '';
const avatarClasses = cn('avatar-default avatar-size-5xl rounded-full', ringClasses, className);
---

<div class={avatarClasses} role="img" aria-label={alt} {...rest}>
	<img
		{src}
		alt=""
		role="presentation"
		width={AVATAR_DIMENSION}
		height={AVATAR_DIMENSION}
		{loading}
		{fetchpriority}
		decoding="async"
		class="absolute inset-0 h-full w-full object-cover"
	/>
</div>
