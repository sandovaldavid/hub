---
import Layout from '@app/layouts/Layout.astro';
import HubPage from '@widgets/hub-page/HubPage.astro';
import { getSEO } from '@data/seo';
import { getAlternateUrls, type Lang } from '@shared/i18n';

const lang: Lang = 'es';
const SEO = getSEO(lang);
const alternates = getAlternateUrls(Astro.url);
---

<Layout {...SEO} {alternates}>
	<HubPage {lang} />
</Layout>
