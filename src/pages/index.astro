---
import Layout from '@app/layouts/Layout.astro';
import { HeroCard, ProfileSnapshot } from '@widgets/hero-section';
import CTAButtons from '@widgets/cta-section/ui/CTAButtons.astro';
import SocialGrid from '@widgets/social-grid/ui/SocialGrid.astro';
import ContactCTA from '@widgets/contact-cta/ui/ContactCTA.astro';
import { SkillsSection } from '@widgets/skills-section';
import { WeeklyProjectSection } from '@widgets/weekly-project-section';

import { profile } from '@data/profile';
import { socialLinks } from '@data/social-links';
import { getCtaButtons } from '@data/cta';
import { skills } from '@data/skills';
import { getFeaturedProjects } from '@data/weekly-project';
import { getSEO } from '@data/seo';
import { siteConfig } from '@data/site.config';
import { getLangFromUrl, useTranslations, getAlternateUrls } from '@shared/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const SEO = getSEO(lang);
const alternates = getAlternateUrls(Astro.url);
const projects = getFeaturedProjects(lang);
const headerSocialLinks = socialLinks.filter(link => link.id !== 'website');

const localizedProfile = {
	...profile,
	tagline: t('profile.tagline'),
	bio: t('profile.bio'),
};

const localizedCtaButtons = getCtaButtons(lang).map(btn => ({
	...btn,
	title: t(`cta.${btn.id}.title`),
	description: t(`cta.${btn.id}.description`),
}));

const heroMetadata = [
	{ label: 'Location', value: t('profile.location') },
	{ label: 'Languages', value: t('profile.languages') },
	{ label: 'Work mode', value: t('profile.workMode') },
];
---

<Layout
	{...SEO}
	{alternates}>
	<main
		id="main-content"
		tabindex="-1"
		class="hub-container mx-auto flex w-full max-w-384 flex-col gap-6 p-4 md:gap-9 md:px-6 md:py-8 lg:gap-10 lg:px-8 lg:py-10 xl:px-10 xl:py-12"
		role="main"
		aria-label={t('page.mainLabel')}>
		<div
			class="bento-grid flex flex-col gap-4 md:grid md:grid-cols-4 md:items-center md:gap-6 lg:grid-cols-10 lg:gap-7 xl:gap-8"
			data-layout-section="hero"
			role="region"
			aria-label={t('hero.sectionsLabel')}>
			<section
				class="bento-item bento-item--hero min-w-0 md:col-span-2 md:col-start-1 md:row-start-1 md:flex md:rounded-2xl md:border md:border-white/80 md:bg-white/45 md:p-4 md:shadow-lg md:backdrop-blur-xl lg:col-span-6 lg:col-start-1 lg:p-5 md:dark:border-primary-900/50 md:dark:bg-neutral-950/40"
				data-layout-column="profile"
				data-layout-panel="profile"
				aria-labelledby="hero-heading">
				<HeroCard
					profile={localizedProfile}
					variant="compact"
					availability={t('profile.availability')}
					primaryAction={{
						label: t('profile.resumeAction'),
						href: siteConfig.resume[lang],
						external: true,
					}}
				/>
			</section>

			<div
				class="bento-item order-2 min-w-0 md:col-span-4 md:row-start-2 lg:col-span-10 lg:row-start-2"
				data-layout-section="profile-snapshot">
				<ProfileSnapshot
					heading={t('profile.snapshotHeading')}
					bio={localizedProfile.bio}
					metadata={heroMetadata}
				/>
			</div>

			<section
				class="bento-item bento-item--social order-3 min-w-0 md:col-span-2 md:col-start-3 md:row-start-1 md:flex md:self-center md:flex-col md:rounded-2xl md:border md:border-white/80 md:bg-white/45 md:p-4 md:shadow-lg md:backdrop-blur-xl lg:col-span-4 lg:col-start-7 lg:p-5 md:dark:border-primary-900/50 md:dark:bg-neutral-950/40"
				data-layout-column="social"
				data-layout-panel="social"
				aria-labelledby="social-heading">
				<h2
					id="social-heading"
					class="mb-2 block text-center text-xs font-semibold uppercase tracking-[0.12em] text-primary-700 md:text-left dark:text-primary-300">
					{t('social.heading')}
				</h2>
				<SocialGrid
					links={headerSocialLinks}
					priorities={['primary', 'secondary']}
					variant="compact"
				/>
			</section>
		</div>

		<section
			class="flex flex-col gap-4 md:gap-6"
			data-layout-section="actions"
			aria-labelledby="cta-heading">
			<header class="bento-item mx-auto max-w-3xl text-center">
				<h2
					id="cta-heading"
					class="m-0 text-2xl font-bold leading-tight text-neutral-900 md:text-3xl dark:text-neutral-50">
					{t('cta.heading')}
				</h2>
				<p class="mx-auto mt-2 text-sm leading-relaxed text-neutral-600 md:text-base dark:text-neutral-300">
					{t('cta.description')}
				</p>
			</header>

			<div class="grid grid-cols-1 gap-4 md:gap-6 lg:grid-cols-3 lg:items-start">
				<div
					class="bento-item bento-item--cta flex min-w-0 lg:col-span-2"
					data-layout-column="primary-actions">
					<CTAButtons
						buttons={localizedCtaButtons}
						layout="vertical"
					/>
				</div>
				<section
					class="bento-item bento-item--contact flex min-w-0"
					data-layout-column="contact"
					aria-labelledby="contact-heading">
					<ContactCTA
						email={profile.contact.email}
						title={t('contact.title')}
						message={t('contact.message')}
						buttonText={t('contact.buttonText')}
						variant="default"
					/>
				</section>
			</div>
		</section>

		<section
			class="bento-item bento-item--weekly-project"
			data-layout-section="projects">
			<WeeklyProjectSection
				{projects}
				{lang}
			/>
		</section>

		<section
			class="bento-item bento-item--skills"
			data-layout-section="skills"
			aria-labelledby="skills-heading">
			<SkillsSection
				{skills}
				title={t('skills.title')}
				variant="compact"
			/>
		</section>
	</main>
</Layout>

<style>
	.bento-item {
		animation: fade-in 0.6s ease-out forwards;
		opacity: 0;
	}

	.bento-item--hero {
		animation-delay: 0.1s;
	}
	.bento-item--social {
		animation-delay: 0.2s;
	}
	.bento-item--cta {
		animation-delay: 0.25s;
	}
	.bento-item--weekly-project {
		animation-delay: 0.35s;
	}
	.bento-item--skills {
		animation-delay: 0.45s;
	}
	.bento-item--contact {
		animation-delay: 0.5s;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bento-item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
