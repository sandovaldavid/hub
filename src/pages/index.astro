---
import Layout from '@app/layouts/Layout.astro';
import HeroCard from '@widgets/hero-section/ui/HeroCard.astro';
import CTAButtons from '@widgets/cta-section/ui/CTAButtons.astro';
import SocialGrid from '@widgets/social-grid/ui/SocialGrid.astro';
import ContactCTA from '@widgets/contact-cta/ui/ContactCTA.astro';
import { SkillsSection } from '@widgets/skills-section';

import { profile } from '@data/profile';
import { socialLinks } from '@data/social-links';
import { ctaButtons } from '@data/cta';
import { skills } from '@data/skills';
import { SEO } from '@data/seo';
---

<Layout
	title={SEO.title}
	description={SEO.description}
	author={SEO.author}
	ogImage={SEO.ogImage}
	themeColor={SEO.themeColor}>
	<main
		id="main-content"
		class="hub-container p-4 md:p-8 md:px-6 lg:p-12 lg:px-8 xl:p-16 mx-auto"
		role="main"
		aria-label="Contenido principal">
		<!-- Hidden h1 for SEO and Screen Readers -->
		<h1 class="sr-only">
			{profile.name} - {profile.tagline}
		</h1>

		<div
			class="bento-grid flex flex-col gap-4 md:grid md:grid-cols-2 md:gap-6 lg:grid-cols-4 lg:gap-6 lg:items-start xl:gap-8 2xl:mx-auto"
			role="region"
			aria-label="Secciones de perfil">
			<!-- Hero Section - Large featured card -->
			<section
				class="bento-item bento-item--hero md:col-span-2 lg:col-span-2 lg:row-start-1"
				aria-labelledby="hero-heading">
				<HeroCard {profile} variant="default" />
			</section>

			<!-- Social Links Grid - Medium card -->
			<section
				class="bento-item bento-item--social md:col-span-2 lg:col-span-2 lg:row-start-1"
				aria-labelledby="social-heading">
				<h2 id="social-heading" class="sr-only">Enlaces de redes sociales</h2>
				<SocialGrid links={socialLinks} showOnlyPrimary={true} variant="default" />
			</section>
		</div>

		<section class="flex flex-col md:flex-row gap-8 py-8 justify-between">
			<!-- CTA Buttons - Funnel conversion -->
			<section
				class="bento-item bento-item--cta md:w-3/5 flex lg:row-2"
				aria-labelledby="cta-heading">
				<CTAButtons buttons={ctaButtons} layout="vertical" />
			</section>
			<!-- Contact CTA - Business capture -->
			<section
				class="bento-item bento-item--contact md:col-span-2 lg:col-span-1 lg:row-start-2"
				aria-labelledby="contact-heading">
				<ContactCTA
					email={profile.contact.email}
					title="¿Tienes un proyecto en mente?"
					message="Hablemos sobre cómo puedo ayudarte a alcanzar tus objetivos"
					buttonText="Hablemos"
					variant="prominent"
				/>
			</section>
		</section>
		<!-- Skills Section - Technologies (Desktop only) -->
		<section
			class="bento-item bento-item--skills hidden lg:block lg:col-span-4 lg:row-start-3"
			aria-labelledby="skills-heading">
			<h2 id="skills-heading" class="sr-only">Tecnologías y habilidades</h2>
			<SkillsSection {skills} title="El motor detrás de las soluciones" variant="compact" />
		</section>
	</main>
</Layout>

<style>
	.bento-item {
		animation: fade-in 0.6s ease-out forwards;
		opacity: 0;
	}

	.bento-item--hero {
		animation-delay: 0.1s;
	}

	.bento-item--social {
		animation-delay: 0.2s;
	}

	.bento-item--cta {
		animation-delay: 0.25s;
	}

	.bento-item--projects {
		animation-delay: 0.3s;
	}

	.bento-item--tips {
		animation-delay: 0.4s;
	}

	.bento-item--skills {
		animation-delay: 0.35s;
	}

	.bento-item--contact {
		animation-delay: 0.5s;
	}

	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
