---
import Layout from '@app/layouts/Layout.astro';
import HeroCard from '@widgets/hero-section/ui/HeroCard.astro';
import CTAButtons from '@widgets/cta-section/ui/CTAButtons.astro';
import SocialGrid from '@widgets/social-grid/ui/SocialGrid.astro';
import ContactCTA from '@widgets/contact-cta/ui/ContactCTA.astro';
import { SkillsSection } from '@widgets/skills-section';
import { WeeklyProjectSection } from '@widgets/weekly-project-section';

import { profile } from '@data/profile';
import { socialLinks } from '@data/social-links';
import { getCtaButtons } from '@data/cta';
import { skills } from '@data/skills';
import { getFeaturedProjects } from '@data/weekly-project';
import { getSEO } from '@data/seo';
import { siteConfig } from '@data/site.config';
import { getLangFromUrl, useTranslations, getAlternateUrls } from '@shared/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const SEO = getSEO(lang);
const alternates = getAlternateUrls(Astro.url);
const projects = getFeaturedProjects(lang);

const localizedProfile = {
	...profile,
	tagline: t('profile.tagline'),
	bio: t('profile.bio'),
};

const localizedCtaButtons = getCtaButtons(lang).map(btn => ({
	...btn,
	title: t(`cta.${btn.id}.title`),
	description: t(`cta.${btn.id}.description`),
}));

const heroMetadata = [
	{ label: 'Location', value: t('profile.location') },
	{ label: 'Work mode', value: t('profile.workMode') },
	{ label: 'Languages', value: t('profile.languages') },
];
---

<Layout {...SEO} {alternates}>
	<main
		id="main-content"
		class="hub-container p-4 md:p-8 md:px-6 lg:p-12 lg:px-8 xl:p-16 mx-auto"
		role="main"
		aria-label={t('page.mainLabel')}>
		<div
			class="bento-grid flex flex-col gap-4 md:grid md:grid-cols-4 md:gap-6 lg:grid-cols-8 lg:gap-6 lg:items-start xl:gap-8 2xl:mx-auto"
			role="region"
			aria-label={t('hero.sectionsLabel')}>
			<section
				class="bento-item bento-item--hero md:col-span-2 lg:col-span-4 lg:row-start-1"
				aria-labelledby="hero-heading">
				<HeroCard
					profile={localizedProfile}
					variant="default"
					availability={t('profile.availability')}
					metadata={heroMetadata}
					primaryAction={{
						label: t('profile.resumeAction'),
						href: siteConfig.resume[lang],
						external: true,
					}}
				/>
			</section>

			<section
				class="bento-item bento-item--social md:col-span-2 lg:col-span-4 lg:row-start-1"
				aria-labelledby="social-heading">
				<h2 id="social-heading" class="sr-only">{t('social.heading')}</h2>
				<SocialGrid links={socialLinks} priorities={['primary', 'secondary']} variant="default" />
			</section>
		</div>

		<section class="flex flex-col gap-4 md:grid md:grid-cols-4 md:gap-6 py-8">
			<section class="bento-item bento-item--cta flex md:col-span-2" aria-labelledby="cta-heading">
				<CTAButtons buttons={localizedCtaButtons} layout="vertical" />
			</section>
			<section
				class="bento-item bento-item--contact md:col-span-2 lg:col-span-2"
				aria-labelledby="contact-heading">
				<ContactCTA
					email={profile.contact.email}
					title={t('contact.title')}
					message={t('contact.message')}
					buttonText={t('contact.buttonText')}
					variant="default"
				/>
			</section>
		</section>

		<section class="bento-item bento-item--weekly-project py-8">
			<WeeklyProjectSection {projects} {lang} />
		</section>

		<section
			class="bento-item bento-item--skills md:col-span-2 lg:col-span-4 lg:row-start-3"
			aria-labelledby="skills-heading">
			<h2 id="skills-heading" class="sr-only">{t('skills.heading')}</h2>
			<SkillsSection {skills} title={t('skills.title')} variant="compact" />
		</section>
	</main>
</Layout>

<style>
	.bento-item {
		animation: fade-in 0.6s ease-out forwards;
		opacity: 0;
	}

	.bento-item--hero { animation-delay: 0.1s; }
	.bento-item--social { animation-delay: 0.2s; }
	.bento-item--cta { animation-delay: 0.25s; }
	.bento-item--weekly-project { animation-delay: 0.35s; }
	.bento-item--skills { animation-delay: 0.45s; }
	.bento-item--contact { animation-delay: 0.5s; }

	@keyframes fade-in {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
