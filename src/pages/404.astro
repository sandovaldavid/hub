---
import Layout from '@app/layouts/Layout.astro';
import { getSEO } from '@data/seo';

const SEO = {
	...getSEO('en'),
	title: 'Page not found | David Sandoval',
	description: "The requested page could not be found on David Sandoval's professional site.",
	socialDescription:
		"This page isn't available. Return to David Sandoval's professional profile to continue.",
	robots: 'noindex, follow',
};
---

<Layout
	{...SEO}
	emitCanonical={false}
	emitStructuredData={false}
	showShare={false}
	showLanguageToggle={false}>
	<main
		id="main-content"
		tabindex="-1"
		class="mx-auto flex w-full max-w-5xl flex-1 items-center justify-center px-4 py-12 md:px-6 md:py-16">
		<section class="w-full text-center" aria-labelledby="not-found-heading" data-not-found-content>
			<p
				aria-hidden="true"
				class="font-technical m-0 text-[clamp(5.5rem,18vw,10rem)] font-bold leading-none tracking-[-0.05em] text-channel-accent-primary">
				404
			</p>

			<div class="mx-auto mt-8 max-w-3xl">
				<h1
					id="not-found-heading"
					class="font-display m-0 text-2xl font-extrabold uppercase leading-tight tracking-[0.12em] text-channel-content-strong md:text-4xl">
					Page not found
				</h1>
				<p
					lang="es"
					class="font-technical mt-2 text-sm font-semibold uppercase tracking-[0.1em] text-channel-content-muted md:text-base">
					Página no encontrada
				</p>

				<div class="mx-auto mt-7 max-w-2xl border-y border-card-edge px-4 py-5">
					<p class="m-0 text-base leading-relaxed text-channel-content-muted md:text-lg">
						The requested destination is not available. The link may be outdated or the page may
						have moved.
					</p>
					<p lang="es" class="mt-2 text-sm leading-relaxed text-channel-content-muted md:text-base">
						El destino solicitado no está disponible. El enlace puede estar desactualizado o la
						página puede haber cambiado.
					</p>
				</div>

				<nav
					class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"
					aria-label="Page recovery options">
					<a
						class="inline-flex min-h-11 items-center justify-center rounded-xl bg-button-primary-background px-6 py-2.5 font-semibold text-button-primary-content transition-colors hover:bg-button-primary-background-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
						href="/">
						Go to homepage
					</a>
					<a
						class="inline-flex min-h-11 items-center justify-center rounded-xl border border-button-secondary-edge bg-button-secondary-background px-6 py-2.5 font-semibold text-button-secondary-content transition-colors hover:bg-button-secondary-background-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
						href="/"
						data-history-back>
						Go back
					</a>
				</nav>

				<p class="mt-6 text-sm text-channel-content-muted">
					<span lang="es">¿Prefieres español?</span>
					<a
						class="ml-1 font-semibold text-channel-accent-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
						href="/es/"
						lang="es">
						Ir al inicio en español
					</a>
				</p>
			</div>
		</section>
	</main>

	<script>
		const backLink = document.querySelector<HTMLAnchorElement>('[data-history-back]');

		backLink?.addEventListener('click', event => {
			if (window.history.length <= 1) return;

			event.preventDefault();
			window.history.back();
		});
	</script>
</Layout>
